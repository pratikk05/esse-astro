---
/**
 * Button — variants taken from the Webflow build:
 *  primary   → Client-First `.button` (+ size="small" → `.button.is-small`)
 *  secondary → "Flow Button — Figma secondary style" custom embed
 *  icon      → testimonial arrow button (pass an icon in the default slot + `label`)
 * Renders <a> when `href` is set, otherwise <button>.
 */
interface Props {
  variant?: "primary" | "secondary" | "icon";
  size?: "default" | "small";
  href?: string;
  label?: string; // required for icon buttons (accessible name)
  type?: "button" | "submit" | "reset";
  class?: string;
  [attr: `data-${string}`]: string | undefined; // JS hooks, e.g. data-prev
}

const { variant = "primary", size = "default", href, label, type = "button", class: className, ...attrs } = Astro.props;
const Tag = href ? "a" : "button";
const classes = ["component-button", `is-${variant}`, { "is-small": size === "small" }, className];
---

<Tag class:list={classes} href={href} type={href ? undefined : type} aria-label={variant === "icon" ? label : undefined} {...attrs}>
  {
    variant === "secondary" ? (
      <>
        <span class="flow-button-circle" aria-hidden="true" />
        <svg class="flow-button-arrow is-left" viewBox="0 0 5 10" aria-hidden="true"><path d="M0 0l5 5-5 5z" /></svg>
        <span class="flow-button-text"><slot /></span>
        <svg class="flow-button-arrow is-right" viewBox="0 0 5 10" aria-hidden="true"><path d="M0 0l5 5-5 5z" /></svg>
      </>
    ) : (
      <slot />
    )
  }
</Tag>

<style>
  @layer components {
    .component-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      text-decoration: none;
      cursor: pointer;
    }

    /* ---- primary (Client-First .button) ---- */
    .is-primary {
      padding: 0.75rem 1.5rem;
      border-radius: var(--radius-sm);
      background-color: var(--color-black);
      color: var(--color-white);
      font-weight: var(--font-weight-semibold);
      transition: opacity var(--duration-fast) ease;
    }
    .is-primary.is-small {
      padding: 0.5rem 1.25rem;
    }
    .is-primary:hover {
      opacity: 0.85;
    }

    /* ---- secondary (Flow Button) ---- */
    .is-secondary {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      gap: 12px;
      width: 126px;
      height: 40px;
      padding: 8px 20px;
      border: 1px solid #d4d4d4;
      border-radius: 2px;
      background: transparent;
      color: #3e3e3e;
      font-family: var(--font-primary);
      font-size: 13px;
      font-weight: var(--font-weight-semibold);
      line-height: 1;
      letter-spacing: var(--tracking-sm);
      white-space: nowrap;
      transition:
        border-radius 600ms cubic-bezier(0.23, 1, 0.32, 1),
        border-color 600ms cubic-bezier(0.23, 1, 0.32, 1),
        color 600ms cubic-bezier(0.23, 1, 0.32, 1),
        transform var(--duration-fast) ease;
    }
    .flow-button-circle {
      position: absolute;
      z-index: 0;
      top: 50%;
      left: 50%;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: #111;
      opacity: 0;
      transform: translate(-50%, -50%);
      transition:
        width 800ms var(--ease-out-expo),
        height 800ms var(--ease-out-expo),
        opacity 800ms var(--ease-out-expo);
    }
    .flow-button-text {
      position: relative;
      z-index: 2;
      flex: none;
      transform: translateX(-8px);
      transition: transform 800ms ease-out;
    }
    .flow-button-arrow {
      position: absolute;
      z-index: 3;
      width: 5px;
      height: 10px;
      fill: #3e3e3e;
      transition:
        left 800ms cubic-bezier(0.34, 1.56, 0.64, 1),
        right 800ms cubic-bezier(0.34, 1.56, 0.64, 1),
        fill 800ms ease;
    }
    .flow-button-arrow.is-left { left: -25%; }
    .flow-button-arrow.is-right { right: 20px; }
    .is-secondary:hover { border-color: transparent; border-radius: 8px; color: #fff; }
    .is-secondary:hover .flow-button-circle { width: 220px; height: 220px; opacity: 1; }
    .is-secondary:hover .flow-button-text { transform: translateX(8px); }
    .is-secondary:hover .flow-button-arrow { fill: #fff; }
    .is-secondary:hover .flow-button-arrow.is-left { left: 20px; }
    .is-secondary:hover .flow-button-arrow.is-right { right: -25%; }
    .is-secondary:active { transform: scale(0.95); }

    /* ---- icon (testimonial arrow) ---- */
    .is-icon {
      width: 2.5rem;
      height: 2.5rem;
      padding: 0.4375rem;
      border: 0.5px solid var(--color-grey-40);
      border-radius: var(--radius-xs);
      background: transparent;
      color: inherit;
    }
    .is-icon :global(svg) {
      width: 0.7056rem;
      height: 0.7056rem;
    }

    .component-button:focus-visible {
      outline: 2px solid #111;
      outline-offset: 4px;
    }
  }
</style>
