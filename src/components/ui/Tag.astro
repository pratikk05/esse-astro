---
/** Section tag: accent square + mono label (e.g. "SELECTED WORKS"). */
interface Props {
  label: string;
  tone?: "muted" | "light";
  class?: string;
}

const { label, tone = "muted", class: className } = Astro.props;
---

<div class:list={["flex items-center gap-figma-12", tone === "light" ? "text-white" : "text-grey-60", className]}>
  <span class="tag-square" aria-hidden="true"></span>
  <p class="text-12">{label}</p>
</div>
