---
/**
 * Journal thumbnail: label-free pixel art + the corner labels as real text on top.
 * Only the art zooms on hover (the parent sets .is-hover / :hover → .jt-art scales); the labels stay put.
 */
import type { Post } from "../../data/journal";

interface Props {
  post: Post;
  index: number;
  ratio?: string; // CSS aspect-ratio
  eager?: boolean;
  class?: string;
}
const { post, index, ratio = "16 / 10", eager = false, class: className } = Astro.props;
const n = String(index + 1).padStart(2, "0");
---

<div class:list={["jt", `is-${post.theme}`, className]} style={`aspect-ratio:${ratio}`}>
  <img class="jt-art" src={post.image} alt={post.alt} width="1200" height="750" loading={eager ? "eager" : "lazy"} decoding="async" />
  <span class="jt-label jt-num text-10" aria-hidden="true">[{n}]</span>
  <span class="jt-label jt-brand text-10" aria-hidden="true">UNIFLOW / JOURNAL</span>
  <span class="jt-label jt-cat text-10" aria-hidden="true"><i></i>{post.category.toUpperCase()}</span>
</div>

<style>
  @layer components {
    .jt {
      position: relative;
      overflow: hidden;
      border: 0.5px solid var(--color-border);
      border-radius: var(--radius-sm);
      background: var(--color-surface);
      --label: rgb(255 255 255 / 0.85);
    }
    .jt.is-light {
      --label: var(--color-grey-60);
    }
    .jt-art {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.9s var(--ease-esse);
    }
    .jt-label {
      position: absolute;
      z-index: 1;
      display: flex;
      align-items: center;
      gap: 0.375rem;
      color: var(--label);
      font-weight: 600;
      letter-spacing: 0.02em;
      pointer-events: none;
    }
    .jt-num {
      top: 0.875rem;
      left: 1rem;
    }
    .jt-brand {
      top: 0.875rem;
      right: 1rem;
    }
    .jt-cat {
      bottom: 0.875rem;
      left: 1rem;
    }
    .jt-cat i {
      width: 6px;
      height: 6px;
      background: var(--color-accent);
    }
    .jt.is-light .jt-cat i {
      background: var(--color-secondary);
    }
    @media (prefers-reduced-motion: reduce) {
      .jt-art {
        transition: none;
      }
    }
  }
</style>
