---
// Team section: embedded page at public/uniflow/team.html (original member reveals).
---

<section class="team-section" aria-label="Our team"><iframe src="/uniflow/team.html" title="Meet the Uniflow team" loading="eager"></iframe></section>

<script>
  // Mobile team content reports its natural height; desktop dimensions stay unchanged.
  const section = document.querySelector<HTMLElement>(".team-section");
  const frame = section?.querySelector("iframe");
  addEventListener("message", (event) => {
    if (!section || event.source !== frame?.contentWindow || event.data?.type !== "uniflow-team-mobile-height" || innerWidth > 767) return;
    const height = Number(event.data.height);
    if (Number.isFinite(height) && height > 0 && height < 10000) section.style.height = height + "px";
  });
  matchMedia("(max-width:767px)").addEventListener("change", () => {
    if (innerWidth > 767) section?.style.removeProperty("height");
  });
</script>
