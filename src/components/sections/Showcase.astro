---
/**
 * Showcase — "Craft in Motion": a compact glimpse of the work. Five project "windows" in the same
 * chrome as the site's floating cards (grey title bar, three dots, mono URL). Each window holds the
 * site's sections stacked like a page: hover a window and it scrolls through them; on touch screens
 * they browse on their own while in view. Then a "See all projects" button.
 * Self-contained (markup + style + script). To remove: delete <Showcase /> (and its import) in
 * src/pages/index.astro. The previous tilted-ribbon version is kept in ShowcaseRibbon.astro (undo:
 * import that instead).
 */
import Tag from "../ui/Tag.astro";

// Same projects + shots as Works (public/images/works/<key>/<n>.webp)
const projects = [
  { key: "ys", name: "YS Homes", industry: "Construction", domain: "ys-homes.webflow.io" },
  { key: "pineapple", name: "Pineapple Retreat", industry: "Company culture", domain: "pineapple-new.webflow.io" },
  { key: "izart", name: "Izart Studio", industry: "Branding studio", domain: "izart.in" },
  { key: "lumikai", name: "Lumikai", industry: "Venture capital", domain: "lumikai.webflow.io" },
  { key: "nocturn", name: "Nocturn Studio", industry: "Creative studio", domain: "nocturn-studio.webflow.io" },
];
---

<section class="showcase section section-pixel" aria-labelledby="showcase-title" data-showcase>
  <div class="white-fade" aria-hidden="true"></div>

  <div class="container relative">
    <header class="sc-head">
      <div>
        <div data-fade><Tag label="IN THE STUDIO" /></div>
        <h2 id="showcase-title" class="sc-title padding-top-12" data-split>Craft in Motion</h2>
      </div>
      <p class="sc-caption text-12 font-semibold text-grey-60" data-fade="1">
        INTERFACES, DETAILS AND EXPERIMENTS<br />FROM THE WORK WE SHIP.
      </p>
    </header>

    <ul class="sc-windows" role="list">
      {
        projects.map((p, i) => (
          <li class="sc-item" data-fade={String((i % 3) + 1)} style={`--i:${i}`}>
            <figure class="sc-window" data-sc-window>
              <div class="sc-bar">
                <span class="sc-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="sc-url text-11">{p.domain}</span>
              </div>
              <div class="sc-view">
                <div class="sc-page">
                  {[1, 2, 3, 4].map((n) => (
                    <img src={`/images/works/${p.key}/${n}.webp`} alt={n === 1 ? `${p.name} website` : ""} width="900" height="900" loading="lazy" decoding="async" draggable="false" />
                  ))}
                </div>
              </div>
            </figure>
            <p class="sc-label text-12">
              <span class="text-grey-50">[0{i + 1}]</span>
              <span class="text-grey-90">{p.name.toUpperCase()}</span>
              <span class="sc-industry text-grey-50">{p.industry.toUpperCase()}</span>
            </p>
          </li>
        ))
      }
    </ul>

    <footer class="sc-foot" data-fade>
      <a href="#work" class="project-cta" data-theme="light">
        <span class="project-cta-icon" aria-hidden="true">
          <svg viewBox="0 0 12 12" width="12" height="12" fill="none"><path d="M1 6h10M6.5 1.5 11 6l-4.5 4.5" stroke="currentColor" stroke-width="1.2" /></svg>
        </span>
        <span class="project-cta-label text-11 font-bold">SEE ALL PROJECTS</span>
      </a>
    </footer>
  </div>

  <!-- Script inside the section: nothing may render between sections (next-sibling overlaps). -->
  <script>
    // Touch screens (no hover): each window browses its sections on its own while on screen.
    document.querySelectorAll<HTMLElement>("[data-showcase]").forEach((section) => {
      if (matchMedia("(hover: hover) and (pointer: fine)").matches) return;
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const windows = [...section.querySelectorAll<HTMLElement>("[data-sc-window]")];
      let timer = 0, tick = 0;
      const step = () => {
        tick++;
        windows.forEach((w, i) => w.style.setProperty("--step", String((tick + i) % 4)));
      };
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting && !timer) timer = window.setInterval(step, 2600);
        else if (!e.isIntersecting && timer) { clearInterval(timer); timer = 0; }
      }).observe(section);
    });
  </script>
  <div class="white-fade is-bottom" aria-hidden="true"></div>
</section>

<style>
  @layer components {
    .showcase {
      padding-top: clamp(4rem, 7vw, 6rem);
      padding-bottom: clamp(3.5rem, 6vw, 5rem);
    }

    /* ---- Header: one compact row ---- */
    .sc-head {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
    }
    .sc-title {
      margin: 0;
      font-family: var(--font-primary);
      font-size: clamp(2.75rem, 6vw, 5.5rem);
      font-weight: 400;
      line-height: 0.95;
      letter-spacing: -0.04em;
      color: var(--color-grey-90);
      text-transform: uppercase;
    }
    .sc-caption {
      margin: 0;
      text-align: right;
      line-height: 1.5;
    }

    /* ---- Project windows (chrome = the About floating cards) ---- */
    .sc-windows {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.25rem;
      align-items: start;
      margin: clamp(2.5rem, 4vw, 3.5rem) 0 0;
      padding: 0;
      list-style: none;
    }
    .sc-item:nth-child(even) {
      margin-top: 2.5rem; /* staggered rhythm */
    }
    .sc-window {
      margin: 0;
      overflow: hidden;
      border: 1px solid #dfdede;
      border-radius: 6px;
      background: var(--color-white);
      box-shadow: 0 18px 40px -26px rgb(0 2 3 / 0.3);
      transition: translate 0.6s var(--ease-esse), box-shadow 0.6s var(--ease-esse);
    }
    .sc-bar {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.625rem 0.75rem;
      background: #ededed;
    }
    .sc-dots {
      display: flex;
      flex: none;
      gap: 4px;
    }
    .sc-dots i {
      width: 8px;
      height: 8px;
      border: 1px solid #bfc2c7;
      border-radius: 50%;
      background: #c4c7c9;
      transition: background-color 0.4s, border-color 0.4s;
    }
    .sc-url {
      overflow: hidden;
      color: var(--color-grey-60);
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    /* the page: four section shots stacked; --step (0–3) picks which one is in view */
    .sc-view {
      aspect-ratio: 1;
      overflow: hidden;
    }
    .sc-page {
      transform: translateY(calc(var(--step, 0) * -25%));
      transition: transform 1.2s var(--ease-esse);
    }
    .sc-page img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1;
      object-fit: cover;
      user-select: none;
    }
    .sc-label {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 0.5rem;
      margin: 0.875rem 0 0;
    }
    .sc-industry {
      width: 100%;
    }

    @media (hover: hover) and (pointer: fine) {
      /* hover: lift the window, light its dot, scroll down the whole page */
      .sc-item:hover .sc-window {
        translate: 0 -6px;
        box-shadow: 0 28px 50px -26px rgb(0 2 3 / 0.38);
      }
      .sc-item:hover .sc-dots i:first-child {
        background: var(--color-secondary);
        border-color: var(--color-secondary);
      }
      .sc-item:hover .sc-page {
        transform: translateY(-75%);
        transition: transform 5s cubic-bezier(0.45, 0, 0.55, 1);
      }
    }

    /* ---- See all projects ---- */
    .sc-foot {
      display: flex;
      justify-content: center;
      margin-top: clamp(2.5rem, 4vw, 3.5rem);
    }

    @media (width < 62rem) {
      .sc-head {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
      }
      .sc-caption {
        text-align: left;
      }
      /* swipeable row */
      .sc-windows {
        grid-template-columns: none;
        grid-auto-flow: column;
        grid-auto-columns: min(68vw, 17rem);
        overflow-x: auto;
        margin-inline: calc(var(--container-padding) * -1);
        padding: 0.5rem var(--container-padding) 1rem;
        scroll-snap-type: x mandatory;
        scroll-padding-inline: var(--container-padding);
        scrollbar-width: none;
        overscroll-behavior-x: contain;
      }
      .sc-windows::-webkit-scrollbar {
        display: none;
      }
      .sc-item {
        scroll-snap-align: start;
      }
      .sc-item:nth-child(even) {
        margin-top: 0;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .sc-page,
      .sc-window {
        transition: none !important;
      }
    }
  }
</style>
