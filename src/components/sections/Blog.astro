---
/**
 * Journal — three posts about how the studio designs and builds, above the FAQ.
 * Posts: Sanity → src/data/journal.ts getPosts() (shared with the /blog pages). To remove the section, delete the
 * <Blog /> line (and its import) in src/pages/index.astro.
 * Thumbnails share the site's language: brand field + Bayer-dithered noise (as Stats / CTA), a pixel
 * glyph per topic and JetBrains Mono corner labels — drawn as text over the art (JournalThumb), so on
 * hover only the art zooms; the labels never scale.
 * Cards link to /blog/<slug> while JOURNAL_PAGES is on (src/data/journal.ts).
 */
import Tag from "../ui/Tag.astro";
import RollText from "../ui/RollText.astro";
import JournalThumb from "../journal/JournalThumb.astro";
import { getPosts, postUrl, JOURNAL_PAGES } from "../../data/journal";

const posts = (await getPosts()).slice(0, 3); // latest three
---

<section id="journal" class="blog-section section section-pixel" aria-labelledby="blog-title">
  <div class="white-fade" aria-hidden="true"></div>
  <div class="container relative">
    <div class="padding-y-111">
      <header class="blog-header">
        <div>
          <div data-fade><Tag label="JOURNAL" /></div>
          <h2 id="blog-title" class="heading-48 padding-top-12" data-split>Notes on Design &amp; Build</h2>
        </div>
        <div class="blog-aside" data-fade="1">
          <p class="blog-intro text-12 leading-base tracking-sm font-semibold text-grey-60">
            THINKING FROM THE STUDIO ON DESIGN SYSTEMS, PERFORMANCE AND 3D FOR THE WEB
          </p>
          {JOURNAL_PAGES && <a class="blog-all text-12 font-semibold" href="/blog"><RollText text="ALL NOTES" /> <span aria-hidden="true">→</span></a>}
        </div>
      </header>

      <ul class="blog-grid" role="list">
        {
          posts.map((post, i) => {
            const href = JOURNAL_PAGES ? postUrl(post) : undefined;
            const Card = href ? "a" : "div";
            return (
              <li data-fade={String(i + 1)}>
                <Card class:list={["blog-card", { "is-link": href }]} {...(href ? { href } : {})}>
                  <JournalThumb post={post} index={i} />
                  <p class="blog-meta text-12 font-semibold">
                    <span class="text-grey-90">[0{i + 1}] {post.category.toUpperCase()}</span>
                    <span class="text-grey-50">{post.read.toUpperCase()}</span>
                  </p>
                  <h3 class="blog-title">{post.title}</h3>
                  <p class="blog-excerpt para-14 text-grey-60">{post.excerpt}</p>
                  <p class="blog-foot text-12 font-semibold">
                    <time class="text-grey-50" datetime={post.iso}>{post.date.toUpperCase()}</time>
                    {href && <span class="blog-read text-grey-90"><RollText text="READ ARTICLE" /> →</span>}
                  </p>
                </Card>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
  <div class="white-fade is-bottom" aria-hidden="true"></div>
</section>

<style>
  @layer components {
    .blog-header {
      display: grid;
      grid-template-columns: 1fr minmax(0, 22.5rem);
      align-items: end;
      gap: 2rem;
    }
    .blog-aside {
      display: grid;
      justify-items: start;
      gap: 1.25rem;
    }
    .blog-intro {
      margin: 0;
      text-box: trim-both cap alphabetic;
    }
    .blog-all {
      display: inline-flex;
      gap: 0.75rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--color-grey-90);
      color: var(--color-grey-90);
      text-decoration: none;
    }

    .blog-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
      margin: 4rem 0 0;
      padding: 1.5rem 0 0;
      list-style: none;
      border-top: 1px solid var(--color-grey-20);
    }
    .blog-card {
      display: flex;
      flex-direction: column;
      height: 100%;
      color: inherit;
      text-decoration: none;
    }
    .blog-meta,
    .blog-foot {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin: 0;
      text-box: trim-both cap alphabetic;
    }
    .blog-meta {
      margin-top: 1.5rem;
    }
    .blog-title {
      margin: 1.125rem 0 0;
      font-family: var(--font-secondary);
      font-size: 1.375rem; /* 22px */
      font-weight: var(--font-weight-medium);
      line-height: 1.25;
      letter-spacing: -0.03em;
      color: var(--color-grey-90);
      text-wrap: balance;
    }
    .blog-excerpt {
      margin: 0.75rem 0 0;
    }
    .blog-foot {
      margin-top: auto;
      padding-top: 1.5rem;
    }
    .blog-read {
      display: inline-flex;
      gap: 0.375rem;
    }

    @media (hover: hover) and (pointer: fine) {
      /* only the art zooms — the corner labels are text on top and stay put */
      .blog-card:hover :global(.jt-art),
      .blog-card:focus-visible :global(.jt-art) {
        transform: scale(1.04);
      }
    }
    .blog-card.is-link:focus-visible {
      outline: 2px solid var(--color-secondary);
      outline-offset: 6px;
    }

    @media (width < 62rem) {
      .blog-header {
        grid-template-columns: 1fr;
        align-items: start;
        gap: 1.5rem;
      }
      .blog-grid {
        grid-template-columns: 1fr;
        gap: 3rem;
        margin-top: 2.5rem;
      }
    }
    @media (width >= 48rem) and (width < 62rem) {
      .blog-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
  }
</style>
