---
/**
 * Journal — three posts about how the studio designs and builds, above the FAQ.
 * Self-contained: this file + public/images/blog/. To remove the section, delete the <Blog /> line
 * (and its import) in src/pages/index.astro.
 * Thumbnails share the site's language: brand field + Bayer-dithered noise (as Stats / CTA), the 12px
 * line grid, a pixel glyph per topic and JetBrains Mono corner labels.
 * Cards link only when a post has an `href` (no article pages yet → no dead links).
 */
import Tag from "../ui/Tag.astro";
import RollText from "../ui/RollText.astro";

interface Post {
  category: string;
  title: string;
  excerpt: string;
  read: string;
  date: string;
  image: string;
  alt: string;
  href?: string;
}

// Placeholder copy and dates: replace with real posts (and add `href`) when articles are published.
const posts: Post[] = [
  {
    category: "Design systems",
    title: "Why every site we build starts with a design system",
    excerpt: "Tokens, spacing and type scales decided once — so every new page stays consistent as your site grows.",
    read: "6 min read",
    date: "04 Nov 2026",
    image: "/images/blog/design-systems.png",
    alt: "Pixel grid of interface components on electric blue",
  },
  {
    category: "Performance",
    title: "Performance is a design decision",
    excerpt: "How we keep motion, 3D and rich visuals fast — and why a good PageSpeed score starts in Figma, not after launch.",
    read: "5 min read",
    date: "21 Oct 2026",
    image: "/images/blog/performance.png",
    alt: "Pixel lightning bolt over a teal dither field",
  },
  {
    category: "3D & Motion",
    title: "Adding depth without the weight: 3D on the web",
    excerpt: "When interactive 3D earns its place on a page, and how we ship it lean enough for every device.",
    read: "7 min read",
    date: "08 Oct 2026",
    image: "/images/blog/3d-on-the-web.png",
    alt: "Isometric pixel cube in electric blue",
  },
];
---

<section id="journal" class="blog-section section section-pixel" aria-labelledby="blog-title">
  <div class="white-fade" aria-hidden="true"></div>
  <div class="container relative">
    <div class="padding-y-111">
      <header class="blog-header">
        <div>
          <div data-fade><Tag label="JOURNAL" /></div>
          <h2 id="blog-title" class="heading-48 padding-top-12" data-split>Notes on Design &amp; Build</h2>
        </div>
        <p data-fade="1" class="blog-intro text-12 leading-base tracking-sm font-semibold text-grey-60">
          THINKING FROM THE STUDIO ON DESIGN SYSTEMS, PERFORMANCE AND 3D FOR THE WEB
        </p>
      </header>

      <ul class="blog-grid" role="list">
        {
          posts.map((post, i) => {
            const Card = post.href ? "a" : "div";
            return (
              <li data-fade={String(i + 1)}>
                <Card class:list={["blog-card", { "is-link": post.href }]} {...(post.href ? { href: post.href } : {})}>
                  <div class="blog-thumb">
                    <img src={post.image} alt={post.alt} width="1200" height="750" loading="lazy" decoding="async" />
                  </div>
                  <p class="blog-meta text-12 font-semibold">
                    <span class="text-grey-90">[0{i + 1}] {post.category.toUpperCase()}</span>
                    <span class="text-grey-50">{post.read.toUpperCase()}</span>
                  </p>
                  <h3 class="blog-title">{post.title}</h3>
                  <p class="blog-excerpt para-14 text-grey-60">{post.excerpt}</p>
                  <p class="blog-foot text-12 font-semibold">
                    <time class="text-grey-50">{post.date.toUpperCase()}</time>
                    {post.href && <span class="blog-read text-grey-90"><RollText text="READ ARTICLE" /> →</span>}
                  </p>
                </Card>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
  <div class="white-fade is-bottom" aria-hidden="true"></div>
</section>

<style>
  @layer components {
    .blog-header {
      display: grid;
      grid-template-columns: 1fr minmax(0, 22.5rem);
      align-items: end;
      gap: 2rem;
    }
    .blog-intro {
      margin: 0;
      text-box: trim-both cap alphabetic;
    }

    .blog-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
      margin: 4rem 0 0;
      padding: 1.5rem 0 0;
      list-style: none;
      border-top: 1px solid var(--color-grey-20);
    }
    .blog-card {
      display: flex;
      flex-direction: column;
      height: 100%;
      color: inherit;
      text-decoration: none;
    }
    .blog-thumb {
      aspect-ratio: 16 / 10;
      overflow: hidden;
      border: 0.5px solid var(--color-border);
      border-radius: var(--radius-sm);
      background: var(--color-surface);
    }
    .blog-thumb img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.9s var(--ease-esse);
    }
    .blog-meta,
    .blog-foot {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin: 0;
      text-box: trim-both cap alphabetic;
    }
    .blog-meta {
      margin-top: 1.5rem;
    }
    .blog-title {
      margin: 1.125rem 0 0;
      font-family: var(--font-secondary);
      font-size: 1.375rem; /* 22px */
      font-weight: var(--font-weight-medium);
      line-height: 1.25;
      letter-spacing: -0.03em;
      color: var(--color-grey-90);
      text-wrap: balance;
    }
    .blog-excerpt {
      margin: 0.75rem 0 0;
    }
    .blog-foot {
      margin-top: auto;
      padding-top: 1.5rem;
    }
    .blog-read {
      display: inline-flex;
      gap: 0.375rem;
    }

    @media (hover: hover) and (pointer: fine) {
      .blog-card:hover .blog-thumb img,
      .blog-card:focus-visible .blog-thumb img {
        transform: scale(1.04);
      }
    }
    .blog-card.is-link:focus-visible {
      outline: 2px solid var(--color-secondary);
      outline-offset: 6px;
    }

    @media (width < 62rem) {
      .blog-header {
        grid-template-columns: 1fr;
        align-items: start;
        gap: 1.5rem;
      }
      .blog-grid {
        grid-template-columns: 1fr;
        gap: 3rem;
        margin-top: 2.5rem;
      }
    }
    @media (width >= 48rem) and (width < 62rem) {
      .blog-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .blog-thumb img {
        transition: none;
      }
    }
  }
</style>
