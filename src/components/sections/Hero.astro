---
import HeroFeatured from "../ui/HeroFeatured.astro"; // "Featured work" card — remove this + <HeroFeatured /> to undo
---

<section class="section bg-black text-white" data-overlap-under="plain" data-chat-hide>
  <!-- Bottom status bar -->
  <div
    class="absolute inset-x-0 bottom-0 z-2 border-t border-line-on-dark padding-top-21 padding-bottom-40"
    data-reveal="fade" style="--reveal-order: 4"
  >
    <div class="container-wide">
      <!-- Mobile: Available on its own row, Mumbai + Scroll below. Desktop: Available · Scroll (centre) · Mumbai (right). -->
      <div class="hero-status">
        <div class="hero-status-item hero-available">
          <span class="hero-dot" aria-hidden="true"></span>
          <p class="text-12">AVAILABLE FOR NEW PROJECTS</p>
        </div>
        <a class="hero-status-item hero-scroll" href="#clients" data-hero-scroll>
          <span class="hero-scroll-icon" aria-hidden="true">
            <svg viewBox="0 0 12 12" width="12" height="12" fill="none"><path d="M6 1v10M1.5 6.5 6 11l4.5-4.5" stroke="currentColor" stroke-width="1.2" /></svg>
          </span>
          <p class="text-12">SCROLL TO EXPLORE</p>
        </a>
        <div class="hero-status-item hero-location">
          <!-- Wireframe globe: meridians sweep (scaleX) on a staggered loop so it reads as slowly turning -->
          <svg class="hero-globe" viewBox="0 0 21 21" fill="none" aria-hidden="true">
            <g stroke="currentColor" stroke-width="0.8">
              <circle cx="10.5" cy="10.5" r="9.6" />
              <path d="M0.9 10.5h19.2M2.6 5.6h15.8M2.6 15.4h15.8" />
              <ellipse class="hero-meridian" cx="10.5" cy="10.5" rx="9.6" ry="9.6" vector-effect="non-scaling-stroke" />
              <ellipse class="hero-meridian" cx="10.5" cy="10.5" rx="9.6" ry="9.6" vector-effect="non-scaling-stroke" />
              <ellipse class="hero-meridian" cx="10.5" cy="10.5" rx="9.6" ry="9.6" vector-effect="non-scaling-stroke" />
            </g>
          </svg>
          <p class="text-12">BASED IN MUMBAI</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Headline -->
  <div class="container">
    <div class="relative z-1 hero-content flex h-lvh flex-col padding-top-128 max-md:pt-[9.5rem]">
      <h1 class="hero-title heading-64" data-reveal="lift" style="--reveal-order: 1">
        We Make <br />Websites That Hold <br />Your Attention
      </h1>
      <div class="hero-intro-block">
        <p class="hero-intro para-14 font-normal" data-reveal style="--reveal-order: 2">
          We design and build high-performance websites for ambitious brands,
          startups and companies that refuse to look ordinary.
        </p>
        <a href="/contact" class="project-cta margin-top-32" data-theme="dark" data-reveal style="--reveal-order: 3">
          <span class="project-cta-icon" aria-hidden="true">
            <svg viewBox="0 0 12 12" width="12" height="12" fill="none"><path d="M1 6h10M6.5 1.5 11 6l-4.5 4.5" stroke="currentColor" stroke-width="1.2" /></svg>
          </span>
          <span class="project-cta-label text-11 font-bold">START A PROJECT</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Featured work card, bottom-right (components/ui/HeroFeatured.astro) -->
  <HeroFeatured />

  <!-- Liquid gradient background (scripts/modules/hero-gradient.js) -->
  <div class="pointer-events-none absolute inset-0">
    <div id="liquid-gradient">
      <canvas id="liquid-gradient-canvas"></canvas>
    </div>
  </div>

  <!-- Soft top scrim: keeps the logo / nav legible over the bright gradient without dimming the headline -->
  <div class="hero-top-scrim" aria-hidden="true"></div>

  <div class="grid-lines" aria-hidden="true">
    <div></div><div></div><div></div><div></div>
  </div>
  <!-- Script lives inside the section: a <script> rendered between sections would break the
       next-sibling overlap (CSS `+ section`, section-overlap.js / about-scene.js nextElementSibling). -->
  <script>
    import { scrollToTarget } from "../../scripts/lib/scroll-to.js";
    // "Scroll to explore" glides to the logo strip
    document.querySelectorAll<HTMLAnchorElement>("[data-hero-scroll]").forEach((link) =>
      link.addEventListener("click", (e) => {
        const target = document.querySelector(link.hash);
        if (!target) return;
        e.preventDefault();
        scrollToTarget(target);
      }),
    );
  </script>
</section>

<style>
  @layer components {
    /* Text-box widths in em keep the Figma line breaks at every font size. */
    .hero-title {
      width: 9.5em; /* keeps the Figma 3-line break at 64px */
      max-width: 100%;
    }
    .hero-intro-block {
      margin-top: 2rem;
    }
    .hero-intro {
      width: 22.5em; /* 315px at 14px */
      max-width: 100%;
    }
    /* ---- Bottom status bar ---- */
    /* Mobile (Figma "Home Page - Mobile UI"): two left-aligned rows, Available then Mumbai.
       Scroll joins from tablet up — on a phone it only crowded the row. */
    .hero-status {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-areas: "available" "location";
      align-items: center;
      row-gap: 0.75rem;
    }
    .hero-available { grid-area: available; }
    .hero-location { grid-area: location; }
    .hero-scroll { grid-area: scroll; }
    .hero-status .hero-scroll { display: none; }
    @media (width >= 40rem) {
      .hero-status .hero-scroll { display: flex; }
      .hero-status {
        grid-template-columns: 1fr auto 1fr;
        grid-template-areas: "available scroll location";
      }
      .hero-scroll { justify-self: center; }
      .hero-location { justify-self: end; }
    }
    .hero-status-item {
      display: flex;
      align-items: center;
      gap: 0.625rem;
    }
    .hero-status-item p {
      margin: 0;
    }
    /* Phones: every icon sits in the same 21px slot so the labels start on one line */
    @media (width < 40rem) {
      .hero-dot {
        margin-inline: calc((1.3106rem - 0.25rem) / 2);
      }
    }

    /* Available: teal "live" square with a soft ping */
    .hero-dot {
      position: relative;
      flex: none;
      width: 0.25rem;
      height: 0.25rem;
      background: var(--color-accent);
    }
    .hero-dot::after {
      content: "";
      position: absolute;
      inset: 0;
      border: 1px solid var(--color-accent);
      opacity: 0;
    }

    /* Location: wireframe globe, meridians sweep to read as slowly turning */
    .hero-globe {
      width: 1.3106rem; /* 20.97px */
      height: 1.3106rem;
      overflow: visible;
    }

    /* Scroll: arrow drops out of the bottom, re-enters from the top, then rests */
    .hero-scroll {
      color: inherit;
      text-decoration: none;
    }
    .hero-scroll-icon {
      display: grid;
      place-items: center;
      width: 1.3106rem;
      height: 1.3106rem;
      overflow: hidden;
      border: 1px solid var(--color-line-on-dark);
      border-radius: var(--radius-xs);
      transition: border-color 0.3s, background-color 0.3s, color 0.3s;
    }
    .hero-scroll:focus-visible {
      outline: 1px solid var(--color-white);
      outline-offset: 4px;
    }

    /* ---- Continuous, low-key loops (slow, small, low contrast so they never pull focus) ---- */
    .hero-dot::after {
      animation: hero-ping 2.8s cubic-bezier(0.2, 0.6, 0.3, 1) infinite;
    }
    .hero-meridian {
      transform-box: fill-box;
      transform-origin: center;
      opacity: 0.85;
      animation: hero-meridian 9s ease-in-out infinite;
    }
    .hero-meridian:nth-of-type(2) { animation-delay: -3s; }
    .hero-meridian:nth-of-type(3) { animation-delay: -6s; }
    .hero-scroll-icon svg {
      animation: hero-arrow-drop 2.6s var(--ease-esse) infinite;
    }
    /* Scroll is a link: hover still fills the box */
    .hero-scroll:is(:hover, :focus-visible) .hero-scroll-icon {
      border-color: var(--color-white);
      background: var(--color-white);
      color: var(--color-black);
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-dot::after, .hero-scroll-icon svg, .hero-meridian { animation: none !important; }
    }

    @media (width < 48rem) {
      .hero-title br {
        display: none;
      }
    }

    @media (width >= 62rem) {
      .hero-intro-block {
        margin-left: calc(260.6 * var(--px));
      }
    }

    /* Eased black → transparent over the nav band only; ends well above the headline */
    .hero-top-scrim {
      position: absolute;
      inset: 0 0 auto;
      height: 11rem;
      pointer-events: none;
      background-image: linear-gradient(
        180deg,
        rgb(0 0 0 / 0.38) 0%,
        rgb(0 0 0 / 0.22) 35%,
        rgb(0 0 0 / 0.08) 70%,
        rgb(0 0 0 / 0) 100%
      );
    }

    /* The gradient blooms in from the centre once its first frame is drawn (hero-gradient.js adds
       .is-ready), with a soft edge — so the preloader's dots never show a black flash or a pop. */
    #liquid-gradient {
      position: absolute;
      inset: 0;
      z-index: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      pointer-events: none;
      /* slow, soft bloom: a wide feathered edge (30%) that grows over ~5s with a gentle in-out ease,
         while the gradient's light rises and it settles from a slight zoom — it plays during the
         preloader, seen through its dots */
      --hg-r: 0%;
      -webkit-mask-image: radial-gradient(circle at 50% 55%, #000 calc(var(--hg-r) - 30%), transparent var(--hg-r));
      mask-image: radial-gradient(circle at 50% 55%, #000 calc(var(--hg-r) - 30%), transparent var(--hg-r));
      opacity: 0;
      transition:
        --hg-r 5.2s cubic-bezier(0.37, 0, 0.18, 1),
        opacity 2.6s cubic-bezier(0.33, 0, 0.2, 1);
    }
    #liquid-gradient.is-ready {
      --hg-r: 175%;
      opacity: 1;
    }
    #liquid-gradient canvas {
      scale: 1.14;
      transition: scale 6.5s cubic-bezier(0.25, 0, 0.1, 1);
    }
    #liquid-gradient.is-ready canvas {
      scale: 1;
    }
    @media (prefers-reduced-motion: reduce) {
      #liquid-gradient,
      #liquid-gradient canvas {
        transition: none;
      }
    }
    #liquid-gradient canvas {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      -webkit-mask-image: linear-gradient(
        0deg,
        rgb(0 0 0 / 0) 0%,
        rgb(0 0 0 / 1) 100%
      );
      mask-image: linear-gradient(0deg, rgb(0 0 0 / 0) 0%, rgb(0 0 0 / 1) 100%);
    }
  }

  @keyframes hero-ping {
    0% { transform: scale(1); opacity: 0.5; }
    70%, 100% { transform: scale(3.5); opacity: 0; }
  }
  /* A meridian's projected width follows |cos| of its longitude: full → line → full */
  @keyframes hero-meridian {
    0%, 100% { transform: scaleX(1); }
    50% { transform: scaleX(0.04); }
  }
  /* Drop out, re-enter, then rest — most of the cycle is still */
  @keyframes hero-arrow-drop {
    0%, 55% { transform: translateY(0); }
    72% { transform: translateY(140%); }
    72.01% { transform: translateY(-140%); }
    90%, 100% { transform: translateY(0); }
  }
</style>

<style is:global>
  /* animatable radius for the hero gradient's circular reveal */
  @property --hg-r {
    syntax: "<percentage>";
    inherits: false;
    initial-value: 0%;
  }
</style>
