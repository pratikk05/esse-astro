---
import GlobeIcon from "../../assets/svg/globe.svg";
---

<section class="section bg-black text-white">
  <!-- Bottom status bar -->
  <div class="absolute inset-x-0 bottom-0 z-2 border-t border-line-on-dark padding-top-21 padding-bottom-40">
    <div class="container-wide">
      <div class="grid grid-cols-1 items-center justify-items-start gap-figma-8 sm:grid-cols-3 sm:gap-0">
        <div class="flex items-center justify-center gap-figma-10">
          <span class="size-1 flex-none bg-white" aria-hidden="true"></span>
          <p class="text-12">AVAILABLE FOR NEW PROJECTS</p>
        </div>
        <div class="flex items-center justify-center gap-figma-10 sm:justify-self-center">
          <GlobeIcon class="hero-globe" aria-hidden="true" />
          <p class="text-12">BASED IN MUMBAI</p>
        </div>
        <p class="text-12 sm:justify-self-end">©2K26</p>
      </div>
    </div>
  </div>

  <!-- Headline -->
  <div class="container">
    <div class="relative z-1 flex h-lvh flex-col padding-top-128">
      <h1 class="hero-title heading-76">We make websites impossible to ignore.</h1>
      <p class="hero-intro para-16 margin-top-32">
        We design and build high-performance websites for ambitious brands, startups and companies that refuse to look ordinary.
      </p>
    </div>
  </div>

  <!-- Liquid gradient background (scripts/modules/hero-gradient.js) -->
  <div class="pointer-events-none absolute inset-0">
    <div id="liquid-gradient">
      <canvas id="liquid-gradient-canvas"></canvas>
    </div>
  </div>

  <div class="grid-lines" aria-hidden="true">
    <div></div><div></div><div></div><div></div>
  </div>
</section>

<style>
  @layer components {
    /* Text-box widths in em keep the Figma line breaks at every font size. */
    .hero-title {
      width: 8.9263em; /* 678.4px at 76px */
      max-width: 100%;
    }
    .hero-intro {
      width: 18em; /* 288px at 16px */
      max-width: 100%;
    }
    .hero-globe {
      width: 1.3106rem; /* 20.97px */
      height: 1.3106rem;
    }

    @media (width >= 62rem) {
      .hero-intro {
        margin-left: calc(260.6 * var(--px));
      }
    }

    #liquid-gradient {
      position: absolute;
      inset: 0;
      z-index: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      pointer-events: none;
    }
    #liquid-gradient canvas {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      -webkit-mask-image: linear-gradient(0deg, rgb(0 0 0 / 0) 0%, rgb(0 0 0 / 1) 100%);
      mask-image: linear-gradient(0deg, rgb(0 0 0 / 0) 0%, rgb(0 0 0 / 1) 100%);
    }
  }
</style>
