---
// Uniflow services: pinned sculpture + scrolling list (desktop), accordion (mobile).
// Content lives in src/scripts/modules/uniflow-services/data.js; behaviour in the same folder
// (lazy-loaded from main.js).
import "../../styles/uniflow-services.css";
import { services, MOBILE_OPEN } from "../../scripts/modules/uniflow-services/data.js";
const num = (i: number) => `[${String(i + 1).padStart(2, "0")}]`;
const first = services[0];
---

<section id="services" class="services" aria-label="Our services"><div class="services-camera">
  <div class="artwork-track destinationsHero__images"><div class="artwork-sticky">
    <figure class="artwork" aria-label="Selected service artwork"><img id="fallback" src={first.image} alt={first.alt}><canvas aria-hidden="true"></canvas></figure>
    <!-- Every description (+ its tags) is stacked in one grid cell, so the caption always has the height
         of the longest: the model above never shifts when the copy changes from two lines to three -->
    <div class="caption" id="description">{services.map((s, i) => (
      <div class="caption-text" data-desc={i} data-active={i === 0 ? "" : undefined} aria-hidden={i === 0 ? undefined : "true"}>
        <p class="para-16">{s.description}</p>
        <ul class="service-tags" aria-label="Includes">{s.tags.map((t) => <li class="service-tag text-11">{t}</li>)}</ul>
      </div>
    ))}</div>
  </div></div>
  <div class="list-window hero__main"><div class="service-list">
    {services.map((s, i) => (
      <article class="service-row" id={`service-${i + 1}`} data-key={s.key}><h2><button type="button"><span class="service-number">{num(i)}</span><span class="service-title">{s.title}</span></button></h2></article>
    ))}
  </div></div>
</div><div class="red-dot-exit-trigger" aria-hidden="true"></div></section>

<!-- Mobile accordion: title, then its description, then the model -->
<section class="mobile-services" aria-label="Our services">
  {services.map((s, i) => {
    const open = i === MOBILE_OPEN;
    return (
      <article class="ms-row" data-open={open ? "" : undefined}>
        <h2><button class="ms-button" type="button" id={`ms-button-${i}`} aria-expanded={open ? "true" : "false"} aria-controls={`ms-panel-${i}`}><span class="ms-number">{num(i)}</span><span class="ms-title">{s.title}</span><img class="ms-icon" alt="" loading="lazy" decoding="async" src={open ? "/uniflow/img/svg-5-a9a4.svg" : "/uniflow/img/svg-4-ce2f.svg"}></button></h2>
        <div class="ms-panel" id={`ms-panel-${i}`} role="region" aria-labelledby={`ms-button-${i}`}>
          <div class="ms-copy" hidden={!open}>
            <p class="para-16">{s.description}</p>
            <ul class="service-tags" aria-label="Includes">{s.tags.map((t) => <li class="service-tag text-11">{t}</li>)}</ul>
          </div>
          <div class="ms-art" hidden={!open}><img src={s.image} loading="lazy" decoding="async" alt={s.alt}><span class="ms-grid" aria-hidden="true"></span></div>
        </div>
      </article>
    );
  })}
</section>
