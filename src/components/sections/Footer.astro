---
/**
 * Footer — Figma "Footer — Reference layout / Uniflow" (1:3133, desktop) and
 * "Footer — Mobile / Centered" (11:6270). Tablet (768–991) is not in Figma: it keeps the desktop
 * left-aligned structure in two columns so it never looks like a stretched phone layout.
 * Type uses FlowScale classes (text-12 / text-11 / para-14); colours use the style-guide tokens.
 */
import RollText from "../ui/RollText.astro";
import { JOURNAL_PAGES } from "../../data/journal";
import IconInstagram from "../../assets/svg/footer-instagram.svg";
import IconX from "../../assets/svg/footer-x.svg";
import IconLinkedin from "../../assets/svg/footer-linkedin.svg";

// Placeholder hrefs — same as the menu; replace with the real pages / profiles.
interface Props {
  /** false on inner pages: section links point back to the home page. */
  home?: boolean;
}
const { home = true } = Astro.props;
const base = home ? "" : "/";

const navLinks = [
  { label: "HOME", href: home ? "#top" : "/" },
  { label: "ABOUT", href: `${base}#about` },
  { label: "OUR PROJECT", href: `${base}#work` },
  ...(JOURNAL_PAGES ? [{ label: "JOURNAL", href: "/blog" }] : []), // blog pages (src/data/journal.ts)
  { label: "CONTACT", href: "/contact" },
];
const legalLinks = [
  { label: "TERMS & CONDITIONS", href: "#" },
  { label: "PRIVACY POLICY", href: "#" },
];
const socials = [
  { label: "Instagram", href: "#", Icon: IconInstagram, framed: true },
  { label: "X (Twitter)", href: "#", Icon: IconX, framed: false },
  { label: "LinkedIn", href: "#", Icon: IconLinkedin, framed: true },
];
---

<footer class="site-footer bg-grey-100 text-grey-20" aria-label="Site footer" data-chat-hide>
  <div class="footer-inner">
    <div class="footer-top">
      <!-- Left: newsletter + copyright -->
      <div class="footer-left">
        <form class="footer-news" data-footer-form novalidate>
          <p class="footer-news-title text-12 text-grey-20">STAY UPDATED ON NEW DROPS AND UPDATES!!</p>
          <div class="footer-fields">
            <label class="sr-only" for="footer-name">Name</label>
            <input id="footer-name" class="footer-input para-14" type="text" name="name" placeholder="Name" autocomplete="name" />
            <label class="sr-only" for="footer-email">E-Mail</label>
            <input id="footer-email" class="footer-input para-14" type="email" name="email" placeholder="E-Mail" autocomplete="email" />
            <button class="footer-submit text-11 font-bold" type="submit">START A PROJECT</button>
          </div>
        </form>
        <div class="footer-copy text-12">
          <p class="text-grey-30">©COPYRIGHT 2026 UNIFLOW</p>
          <p class="text-grey-50">ALL RIGHT RESERVED</p>
        </div>
      </div>

      <!-- Right: contact, nav, legal, social -->
      <div class="footer-right">
        <div class="footer-enquiry">
          <p class="footer-label text-12">BUSINESS ENQUIRY</p>
          <ul class="footer-contact para-14">
            <li><span class="text-grey-60">E. </span><a class="footer-link-plain" href="mailto:hello@uniflow.example"><RollText text="hello@uniflow.example" /></a></li>
            <li><span class="text-grey-60">P. </span><a class="footer-link-plain" href="tel:+910000000000"><RollText text="+91 00000 00000" /></a></li>
          </ul>
        </div>

        <nav class="footer-nav" aria-label="Footer">
          <p class="footer-label text-12">NAV LINKS</p>
          <ul class="footer-nav-list text-12">
            {navLinks.map(({ label, href }) => <li><a class="footer-link" href={href}><RollText text={label} /></a></li>)}
          </ul>
        </nav>

        <div class="footer-legal">
          <p class="footer-label text-12">LEGAL</p>
          <ul class="footer-legal-list text-12">
            {legalLinks.map(({ label, href }) => <li><a class="footer-link" href={href}><RollText text={label} /></a></li>)}
          </ul>
        </div>

        <ul class="footer-social">
          {
            socials.map(({ label, href, Icon, framed }) => (
              <li>
                <a class:list={["footer-social-link", { "is-framed": framed }]} href={href} aria-label={label}>
                  <Icon aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <hr class="footer-divider" />

    <!-- Linework wordmark: 20 hairlines masked by the Uniflow logo. Live version (canvas): lines draw in
         on view and pluck like strings under the cursor — script below; the CSS mask is the fallback. -->
    <div class="footer-wordmark" role="img" aria-label="Uniflow" data-wordmark></div>
  </div>
</footer>

<style>
  @layer components {
    .site-footer {
      position: relative;
      overflow: clip;
    }
    .footer-inner {
      width: 100%;
      max-width: calc(var(--container-max) + 2 * var(--container-padding));
      margin-inline: auto;
      padding: 2.5rem 1rem 1.5rem; /* 40 / 16 / 24 — Figma mobile */
    }

    /* ---------- Mobile (< 768): centered column, Figma 11:6270 ---------- */
    .footer-top,
    .footer-left,
    .footer-right {
      display: contents;
    }
    .footer-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.75rem; /* 28 */
    }
    .footer-inner > .footer-top,
    .footer-inner > * {
      min-width: 0;
    }

    .footer-news { order: 1; width: 100%; display: flex; flex-direction: column; align-items: center; gap: 1rem; }
    .footer-enquiry { order: 2; margin-top: 0.75rem; } /* 28 + 12 = 40 → 48 below news */
    .footer-nav { order: 3; width: 100%; margin-top: 1.25rem; } /* 28 + 20 = 48 */
    .footer-legal { order: 4; margin-top: 1.25rem; }
    .footer-social { order: 5; }
    .footer-divider { order: 6; }
    .footer-copy { order: 7; }
    .footer-wordmark { order: 8; }

    .footer-news-title { max-width: 17.3125rem; text-align: center; text-wrap: balance; } /* 277 */
    .footer-fields { width: 100%; display: flex; flex-direction: column; gap: 6px; }
    .footer-input {
      width: 100%;
      height: 40px;
      padding: 0 12px;
      border: 0;
      border-radius: var(--radius-xs);
      background: var(--color-grey-80);
      color: var(--color-white);
      font-weight: var(--font-weight-medium);
    }
    .footer-input::placeholder { color: var(--color-grey-30); opacity: 1; }
    .footer-input:focus-visible { outline: 1px solid var(--color-focus); outline-offset: 0; }
    .footer-submit {
      width: 100%;
      height: 40px;
      border: 0;
      border-radius: var(--radius-xs);
      background: var(--color-white);
      color: var(--color-black);
      cursor: pointer;
      transition: background var(--duration-fast) var(--ease-esse);
    }
    .footer-submit:hover { background: var(--color-grey-10); }
    .footer-submit:focus-visible { outline: 2px solid var(--color-white); outline-offset: 3px; }

    .site-footer li { margin: 0; }
    .footer-label { color: var(--color-grey-60); }
    .footer-enquiry,
    .footer-nav,
    .footer-legal { display: flex; flex-direction: column; align-items: center; gap: 1rem; text-align: center; }
    .footer-contact { display: flex; flex-direction: column; align-items: center; gap: 0.875rem; margin: 0; padding: 0; list-style: none; }
    .footer-contact li { white-space: nowrap; }
    .footer-link-plain { color: var(--color-grey-10); text-decoration: none; transition: color var(--duration-fast); }
    .footer-link-plain:hover { color: var(--color-white); }

    .footer-nav-list { width: 100%; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem 1rem; margin: 0; padding: 0 2rem; list-style: none; }
    .footer-legal-list { display: flex; flex-direction: column; align-items: center; gap: 0.875rem; margin: 0; padding: 0; list-style: none; }
    .footer-link { color: var(--color-grey-20); text-decoration: none; white-space: nowrap; transition: color var(--duration-fast); }
    .footer-link:hover { color: var(--color-white); }
    .footer-link:focus-visible,
    .footer-link-plain:focus-visible,
    .footer-social-link:focus-visible { outline: 1px solid var(--color-focus); outline-offset: 4px; border-radius: 2px; }

    .footer-social { display: flex; gap: 10px; margin: 0; padding: 0; list-style: none; }
    .footer-social-link {
      display: grid;
      place-items: center;
      width: 37px;
      height: 37px;
      border-radius: var(--radius-sm);
      color: var(--color-grey-10);
      transition: background var(--duration-fast);
    }
    .footer-social-link.is-framed { border: 0.5px solid var(--color-grey-70); }
    .footer-social-link :global(svg) { display: block; max-width: none; }
    .footer-social-link:not(.is-framed) :global(svg) { width: 100%; height: 100%; }
    .footer-social-link:hover { background: var(--color-grey-90); }

    .footer-divider { order: 6; width: 100%; height: 0; margin: 0; border: 0; border-top: 0.5px solid var(--color-grey-70); }
    .footer-copy { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; text-align: center; white-space: nowrap; }
    .footer-copy p { margin: 0; }

    .footer-wordmark {
      width: 100%;
      aspect-ratio: 1376 / 310;
      opacity: 0.65;
      /* 20 hairlines, pitch = 1/19.375 of the height, masked by the logo (Figma: 16px pitch / 0.8px line at 310px).
         The 0.75px floor keeps the lines visible when the wordmark scales down on phones/tablets. */
      background-image: linear-gradient(to bottom, var(--color-grey-30) 0 max(0.75px, 5%), transparent max(0.75px, 5%) 100%);
      background-size: 100% 5.1613%;
      -webkit-mask: url("/images/footer-wordmark.svg") 0 0 / 100.5814% auto no-repeat;
      mask: url("/images/footer-wordmark.svg") 0 0 / 100.5814% auto no-repeat;
      overflow: clip;
    }
    /* live canvas version: same lines, drawn by the script */
    .footer-wordmark.is-live {
      position: relative;
      background: none;
      -webkit-mask: none;
      mask: none;
      overflow: visible;
    }
    .footer-wordmark :global(canvas) { /* created by the script, so it has no scoped attribute */
      position: absolute;
      inset: -24px 0;
      width: 100%;
      height: calc(100% + 48px);
    }

    /* ---------- Tablet (768–991): two columns, left-aligned ---------- */
    @media (width >= 48rem) {
      .footer-inner {
        display: block;
        padding: 3.5rem var(--container-padding) 2.375rem;
      }
      .footer-top {
        display: grid;
        grid-template-columns: minmax(0, 20.4375rem) minmax(0, 1fr);
        column-gap: 2rem;
        align-items: start;
      }
      .footer-left {
        display: flex;
        flex-direction: column;
        gap: 1.875rem; /* form → copyright (Figma 30px) */
        min-width: 0;
      }
      .footer-right {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        grid-template-areas: "enq nav" "legal legal" "social social";
        column-gap: 1.5rem;
        row-gap: 0;
        min-width: 0;
      }
      .footer-news { align-items: flex-start; }
      .footer-news-title { max-width: none; text-align: left; text-wrap: wrap; }
      .footer-fields { gap: 6px; }
      .footer-input,
      .footer-submit { height: 41px; }
      .footer-submit { height: 40px; }

      .footer-enquiry { grid-area: enq; align-items: flex-start; text-align: left; gap: 1.25rem; margin: 0; }
      .footer-nav { grid-area: nav; align-items: flex-start; text-align: left; gap: 1.25rem; margin: 0; }
      .footer-legal { grid-area: legal; align-items: flex-start; text-align: left; gap: 1.25rem; margin: 2.75rem 0 0; }
      .footer-social { grid-area: social; margin-top: 2.5rem; gap: 6px; }
      .footer-social-link { width: 36px; height: 36px; }
      .footer-contact { align-items: flex-start; gap: 0.875rem; }
      /* Two columns (five links since Journal was added): HOME/ABOUT/OUR PROJECT, then JOURNAL/CONTACT */
      .footer-nav-list { display: grid; grid-auto-flow: column; grid-template-rows: repeat(3, auto); grid-template-columns: auto auto; justify-content: start; column-gap: 2rem; row-gap: 0.75rem; padding: 0; }
      .footer-legal-list { align-items: flex-start; gap: 1rem; }

      .footer-divider { display: none; }
      .footer-copy { align-items: flex-start; text-align: left; gap: 0.875rem; }
      .footer-wordmark { margin-top: 3.5rem; }
    }

    /* ---------- Desktop (>= 992): Figma 1:3133 at 1440 ---------- */
    @media (width >= 62rem) {
      .footer-inner { padding-top: 4.375rem; padding-bottom: 2.375rem; } /* 70 / 38 */
      .footer-top {
        grid-template-columns: minmax(0, calc(327 * var(--px))) minmax(0, 1fr) minmax(0, calc(444 * var(--px)));
        column-gap: 0;
      }
      .footer-left { grid-column: 1; }
      .footer-right {
        grid-column: 3;
        grid-template-columns: calc(270 * var(--px)) minmax(0, 1fr);
        grid-template-rows: calc(154 * var(--px)) auto auto;
        column-gap: 0;
      }
      .footer-legal { margin-top: 0; }
      .footer-wordmark { margin-top: calc(81 * var(--px)); }
    }

    @media (prefers-reduced-motion: reduce) {
      .site-footer * { transition: none !important; }
    }
  }
</style>

<script>
  // "Start a project" in the footer continues on the contact page, carrying over what was typed.
  document.querySelectorAll<HTMLFormElement>("[data-footer-form]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const params = new URLSearchParams();
      for (const [key, value] of new FormData(form)) if (String(value).trim()) params.set(key, String(value).trim());
      const query = params.toString();
      const url = "/contact" + (query ? `?${query}` : "");
      const navigate = (window as any).uniflowNavigate;
      if (location.pathname === "/contact" || !navigate) location.href = url;
      else navigate(url);
    });
  });
</script>

<script>
  // Live linework wordmark: the 20 hairlines are cut from the Uniflow logo (same SVG + geometry as the
  // CSS mask), draw in row by row when the footer comes into view, and pluck like strings under the
  // cursor (spring physics, they brighten while they move). Static lines with reduced motion.
  document.querySelectorAll<HTMLElement>("[data-wordmark]").forEach((host) => {
    const SRC = "/images/footer-wordmark.svg", ROWS = 20, PAD = 24, STEP = 5;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
    const canvas = document.createElement("canvas");
    canvas.setAttribute("aria-hidden", "true");
    const ctx = canvas.getContext("2d")!;
    const logo = new Image();
    logo.src = SRC;
    type Row = { y: number; segs: [number, number][]; d: Float32Array; v: Float32Array };
    let W = 0, H = 0, dpr = 1, rows: Row[] = [], thick = 1, raf = 0, revealStart = 0, revealed = reduce;
    let px = -1e4, py = -1e4, pvy = 0;
    const base = getComputedStyle(document.documentElement).getPropertyValue("--color-grey-30").trim() || "#aeb8b8";

    function build() {
      W = host.clientWidth; H = host.clientHeight;
      if (!W || !H || !logo.naturalWidth) return;
      dpr = Math.min(devicePixelRatio || 1, 2);
      canvas.width = Math.round(W * dpr); canvas.height = Math.round((H + PAD * 2) * dpr);
      // rasterise the logo exactly like the CSS mask (0 0 / 100.5814% auto)
      const off = document.createElement("canvas");
      off.width = Math.ceil(W); off.height = Math.ceil(H);
      const o = off.getContext("2d", { willReadFrequently: true })!;
      const lw = W * 1.005814, lh = lw * (313.803 / 1384);
      o.drawImage(logo, 0, 0, lw, lh);
      const data = o.getImageData(0, 0, off.width, off.height).data;
      const pitch = H * 0.051613;
      thick = Math.max(0.75, pitch * 0.05);
      const n = Math.ceil(W / STEP) + 1;
      rows = [];
      for (let r = 0; r < ROWS; r++) {
        const y = r * pitch + thick / 2;
        const iy = Math.min(off.height - 1, Math.round(y));
        const segs: [number, number][] = [];
        let start = -1;
        for (let x = 0; x <= off.width; x++) {
          const on = x < off.width && data[(iy * off.width + x) * 4 + 3] > 110;
          if (on && start < 0) start = x;
          if (!on && start >= 0) { segs.push([start, x]); start = -1; }
        }
        rows.push({ y, segs, d: new Float32Array(n), v: new Float32Array(n) });
      }
      host.classList.add("is-live");
      wake();
    }

    function draw(now: number) {
      raf = 0;
      ctx.setTransform(dpr, 0, 0, dpr, 0, PAD * dpr);
      ctx.clearRect(0, -PAD, W, H + PAD * 2);
      let moving = false;
      rows.forEach((row, r) => {
        // draw-in: each row sweeps in from the left, one after another (expo-out)
        let reach = W;
        if (!revealed) {
          if (!revealStart) reach = 0; // waits for the footer to come into view
          else {
            const k = Math.min(1, Math.max(0, (now - revealStart - r * 45) / 1100));
            reach = k >= 1 ? W : W * (1 - Math.pow(2, -10 * k));
            if (k < 1) moving = true;
          }
        }
        // strings: pull towards the cursor's vertical motion near it, spring back with a wobble
        if (fine && !reduce) {
          const near = Math.abs(row.y - py) < 70;
          for (let i = 0; i < row.d.length; i++) {
            const x = i * STEP;
            if (near) {
              const f = Math.exp(-((x - px) ** 2) / (2 * 80 ** 2)) * Math.exp(-((row.y - py) ** 2) / (2 * 26 ** 2));
              row.v[i] += pvy * 0.16 * f;
            }
            row.v[i] += -row.d[i] * 0.07;
            row.v[i] *= 0.92; // springy: a few wobbles before it settles
            row.d[i] += row.v[i];
            if (Math.abs(row.d[i]) > 0.02 || Math.abs(row.v[i]) > 0.02) moving = true;
          }
        }
        for (const [x0, x1] of row.segs) {
          if (x0 >= reach) continue;
          const end = Math.min(x1, reach);
          let hot = 0;
          ctx.beginPath();
          for (let x = x0; ; x = Math.min(end, x + STEP)) {
            const i = x / STEP, a = Math.floor(i), b = Math.min(row.d.length - 1, a + 1), f = i - a;
            const dy = row.d[a] + (row.d[b] - row.d[a]) * f;
            hot = Math.max(hot, Math.abs(dy));
            if (x === x0) ctx.moveTo(x, row.y + dy); else ctx.lineTo(x, row.y + dy);
            if (x >= end) break;
          }
          ctx.lineWidth = thick;
          ctx.strokeStyle = hot > 0.6 ? `rgba(255,255,255,${Math.min(1, 0.55 + hot / 10)})` : base;
          ctx.stroke();
        }
      });
      pvy *= 0.6;
      if (!revealed && revealStart && performance.now() - revealStart > 1100 + ROWS * 45) revealed = true;
      if (moving) wake();
    }
    const wake = () => { if (!raf) raf = requestAnimationFrame(draw); };

    if (fine && !reduce) {
      host.addEventListener("pointermove", (e) => {
        const r = canvas.getBoundingClientRect();
        const nx = e.clientX - r.left, ny = e.clientY - r.top - PAD;
        if (px > -1e3) pvy = Math.max(-40, Math.min(40, ny - py));
        px = nx; py = ny;
        wake();
      });
      host.addEventListener("pointerleave", () => { px = py = -1e4; pvy = 0; });
    }
    new IntersectionObserver(([e]) => {
      if (!e.isIntersecting || revealStart) return;
      revealStart = performance.now();
      wake();
    }, { threshold: 0.25 }).observe(host);
    new ResizeObserver(() => build()).observe(host);
    host.append(canvas);
    if (logo.complete) build(); else logo.addEventListener("load", build, { once: true });
  });
</script>
