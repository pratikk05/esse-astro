---
import Tag from "../ui/Tag.astro";
/*
  "Let's talk" (id #about) — a conversation with the visitor in a sticky scroll scene with a dithered CRT TV (Three.js, scripts/modules/about-sculpture.js)
  on the site's 12px line grid; the statement sits in a white card (Figma "About … / Desktop 1441").
  Behaviour: scripts/modules/about-scene.js. Must sit directly before <Stats />:
  the last viewport of this scene dissolves into Stats through a pixel mask.
*/
// A conversation with the visitor in two beats (swap on scroll, like pineapple.design): their problem,
// then how we help. The CRT TV changes channel with them (no signal → brand-blue word wall).
// Copy written with the copywriting skill (coreyhaines31/marketingskills): problem → answer, in the
// customer's language, one idea per beat, no invented claims.
const beats = [
  {
    label: "The problem",
    text: "People judge you before they read a word. If you look like everyone else, they leave.",
  },
  {
    label: "How we help",
    text: "We find what makes you different and build a site that shows it. The same team, start to finish.",
  },
].map((b) => ({ ...b, words: b.text.split(" ") }));

// Website health cards (Figma "2nd Section Floating Cards"): small app windows that rise in with beat 1
// showing a typical poor audit (red), then flip to the "after rebuild" state in brand blue on beat 2
// (numbers count, tick gauges fill, the storefront re-lays itself, the review swaps). Illustrative
// figures, not client results — replace with real audit data when available.
// x/y (mx/my on phones): position inside the free band BELOW the statement (0 = just under it,
// 1 = bottom), so they never cover the copy at any viewport height. d = parallax depth.
const insights = [
  { kind: "score", title: ["Page speed", "Page speed"], bad: 38, good: 96, x: 3, y: 0.06, d: 1.2, mx: 4, my: 0.04 },
  { kind: "design", title: ["Looks like everyone else", "Looks like you"], x: 70, y: 0.0, d: 0.8, mx: 47, my: 0.03 },
  { kind: "metric", title: ["Typical audit", "After rebuild"], label: "Bounce rate", bad: 72, good: 31, worse: "High", better: "Healthy", x: 13, y: 0.7, d: 0.9 },
  { kind: "review", title: ["Customer review", "Customer review"], badStars: 2, goodStars: 5, badQuote: "Looked like every other site. I left.", goodQuote: "Felt premium from the first click. We booked a call.", x: 66, y: 0.66, d: 1.3 },
];
// Tick geometry (Figma): 72 ticks around the PageSpeed gauge, 41 on the bounce scale (every 10th long)
const gaugeTicks = Array.from({ length: 72 }, (_, i) => i);
const scaleTicks = Array.from({ length: 41 }, (_, i) => i);
---

<section id="about" class="about-scene section" aria-label="Let's talk about your website" data-about-scene>
  <div class="about-stage overflow-hidden bg-background" data-about-stage>
    <div class="about-grid" aria-hidden="true" data-about-grid></div>

    <!-- Opening frame: a centred title card; the TV (off) waits below it, scrolling switches it on -->
    <div class="about-opening container" data-about-opening>
      <div class="about-opening-head" data-about-title>
        <Tag label="LET'S TALK" class="justify-center" />
        <h2 class="heading-64 text-grey-90 padding-top-24">Let's talk about <br class="about-br" />your website.</h2>
      </div>
      <ul class="about-promises" data-about-note>
        {["Honest questions", "Straight answers", "No jargon"].map((line, i) => (
          <li>
            <span class="text-12 text-secondary">0{i + 1}</span>
            <span class="text-12 uppercase text-grey-90">{line}</span>
          </li>
        ))}
      </ul>
    </div>
    <p class="about-hint text-12 uppercase text-grey-60" data-about-hint>
      <span class="about-hint-arrow" aria-hidden="true"><i></i><i></i><i></i></span>
      Scroll to switch it on
    </p>

    <canvas class="about-canvas" aria-hidden="true" data-about-canvas></canvas>
    <!-- Caption under the TV, like the reference posters -->
    <p class="about-tv-caption text-12 uppercase" data-about-caption>
      <span>You × Uniflow</span>
    </p>

    <div class="about-statement" data-about-statement>
      <div class="about-paras">
        {
          beats.map((beat, i) => (
            <div class="about-para" data-about-para={i}>
              <p class="about-para-label text-12 uppercase"><span class="about-word"><span>[0{i + 1}] {beat.label}</span></span></p>
              <p class="heading-secondary-32 text-center">
                {beat.words.map((word) => <><span class="about-word"><span>{word}</span></span>{" "}</>)}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="about-gallery" aria-hidden="true" data-about-gallery>
      {
        insights.map((c, i) => (
          <figure class:list={["about-tile insight", `is-kind-${c.kind}`, !c.mx && "is-desktop-only"]} style={`--x:${c.x}%;--y:${c.y};--mx:${c.mx ?? 0}%;--my:${c.my ?? 0};--i:${i}`} data-about-tile data-depth={c.d}>
            <div class="insight-card" style={c.bad != null ? `--val:${c.bad}` : undefined}>
              <p class="insight-bar text-12 uppercase">
                <span class="insight-dots"><i></i><i></i><i></i></span>
                {c.title[0] === c.title[1] ? (
                  <span>{c.title[0]}</span>
                ) : (
                  <span class="insight-swap"><b class="insight-when-bad">{c.title[0]}</b><b class="insight-when-good">{c.title[1]}</b></span>
                )}
              </p>
              {c.kind === "score" && (
                <div class="insight-body insight-score">
                  <svg viewBox="0 0 114.35 114.35" aria-hidden="true">
                    {gaugeTicks.map((t) => (
                      <line x1="57.175" y1="13.175" x2="57.175" y2="1.175" transform={`rotate(${t * 5} 57.175 57.175)`} style={`--t:${t / 72}`} />
                    ))}
                  </svg>
                  <span class="insight-num" data-insight-num data-bad={c.bad} data-good={c.good} data-dec="0">{c.bad}</span>
                </div>
              )}
              {c.kind === "metric" && (
                <div class="insight-body insight-metric">
                  <p class="insight-value"><span class="insight-big"><span data-insight-num data-bad={c.bad} data-good={c.good} data-dec="0">{c.bad}</span><small>%</small></span><span class="insight-label">{c.label}</span></p>
                  <div class="insight-scale">
                    {scaleTicks.map((t) => <i class:list={[t % 10 === 0 && "is-long"]} style={`--t:${t / 40}`}></i>)}
                  </div>
                  <p class="insight-status">
                    <span class="insight-swap"><b class="insight-when-bad"><em>●</em> {c.worse}</b><b class="insight-when-good"><em>●</em> {c.better}</b></span>
                    <span class="insight-range">0 – 100%</span>
                  </p>
                </div>
              )}
              {c.kind === "design" && (
                <div class="insight-body">
                  <div class="insight-design">
                    <i class="s-p s-p1"></i><i class="s-p s-p2"></i><i class="s-p s-p3"></i>
                    <i class="s-nav"></i><i class="s-cart"></i>
                    <i class="s-t s-t1"></i><i class="s-t s-t2"></i><i class="s-t s-t3"></i>
                    <i class="s-pr s-pr1"></i><i class="s-pr s-pr2"></i><i class="s-pr s-pr3"></i>
                    <i class="s-btn"></i>
                  </div>
                </div>
              )}
              {c.kind === "review" && (
                <div class="insight-body insight-review">
                  <p class="insight-stars" role="img" aria-label={`${c.badStars} of 5 stars, then ${c.goodStars} of 5`}>
                    {[0, 1, 2, 3, 4].map((s) => (
                      <span class:list={["insight-star", s < (c.badStars ?? 0) && "is-on-bad", s < (c.goodStars ?? 5) && "is-on-good"]} style={`--s:${s}`} aria-hidden="true"><i class="star-o">☆</i><i class="star-f">★</i></span>
                    ))}
                  </p>
                  <p class="insight-quote insight-swap"><b class="insight-when-bad">{c.badQuote}</b><b class="insight-when-good">{c.goodQuote}</b></p>
                </div>
              )}
            </div>
          </figure>
        ))
      }
    </div>
  </div>
  <!-- Script lives inside the section: a <script> rendered between sections would break the
       next-sibling overlap (CSS `+ section`, section-overlap.js / about-scene.js nextElementSibling). -->
  <script>
    // Idle float switch: .is-scrolling on the scene while the page moves, removed ~180ms after it stops.
    const scene = document.querySelector<HTMLElement>("[data-about-scene]");
    if (scene) {
      let t = 0;
      addEventListener("scroll", () => {
        scene.classList.add("is-scrolling");
        clearTimeout(t);
        t = window.setTimeout(() => scene.classList.remove("is-scrolling"), 180);
      }, { passive: true });
    }
  </script>
</section>

<style>
  @layer components {
    /* Scroll length: story + 1.1 viewports for the pixel dissolve into Stats */
    .about-scene {
      height: 480svh; /* two conversation beats + website health cards */
      background-color: var(--color-secondary);
    }
    .about-stage {
      position: sticky;
      top: 0;
      z-index: 4; /* above Stats while the masked surface releases it */
      height: 100svh;
      min-height: 33.75rem; /* 540px */
      isolation: isolate;
      pointer-events: none;
    }
    /* Next section slides under the last viewport of the scene */
    .about-scene + :global(section) {
      margin-top: -100svh;
      z-index: 3;
    }

    .about-grid {
      position: absolute;
      inset: 0;
      /* Same 12px ripple grid as Works / Team (scripts/modules/ripple-grid.js); about-dissolve.frag
         paints the identical grid during the pixel dissolve, so keep the two in sync. */
    }

    /* Opening frame: centred title card */
    .about-opening {
      position: absolute;
      z-index: 2;
      left: 0;
      right: 0;
      top: max(7.5rem, 15%);
      display: grid;
      justify-items: center;
      text-align: center;
    }
    .about-promises {
      display: grid;
      gap: 0.5rem;
      justify-items: start; /* phones: a left-aligned list in a centred column */
      margin: 1.5rem 0 0;
      padding: 0;
      list-style: none;
    }
    .about-promises li {
      display: flex;
      gap: 0.625rem;
    }
    /* Scroll cue: three pixels dropping in sequence */
    .about-hint {
      position: absolute;
      z-index: 2;
      left: 50%;
      bottom: 7%;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin: 0;
      translate: -50% 0;
      white-space: nowrap;
    }
    .about-hint-arrow {
      display: grid;
      gap: 2px;
    }
    .about-hint-arrow i {
      width: 4px;
      height: 4px;
      background-color: var(--color-secondary);
      animation: about-cue 1.4s var(--ease-esse) infinite;
    }
    .about-hint-arrow i:nth-child(2) { animation-delay: 0.15s; }
    .about-hint-arrow i:nth-child(3) { animation-delay: 0.3s; }
    @keyframes about-cue {
      0%, 100% { opacity: 0.2; }
      40% { opacity: 1; }
    }

    .about-opening {
      position: absolute;
      z-index: 2;
      left: 0;
      top: 8.5rem; /* phones: under the chapter progress, the TV sits below */
      width: 100%;
    }

    .about-canvas {
      position: absolute;
      inset: 0;
      z-index: 1;
      display: block;
      width: 100%;
      height: 100%;
    }

    .about-statement {
      position: absolute;
      z-index: 2;
      top: 14%;
      left: 4%;
      width: 92%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      padding: 0.5rem 1.25rem;
      opacity: 0;
    }
    /* Both statements share one grid cell, so the card keeps the taller one's height while they swap */
    .about-paras {
      display: grid;
    }
    .about-para {
      grid-area: 1 / 1;
      margin: 0;
    }
    .about-para {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.875rem;
    }
    .about-para-label .about-word {
      color: inherit;
    }
    .about-para-label {
      margin: 0;
      color: var(--color-secondary);
      letter-spacing: -0.01em;
    }
    .about-para p:last-child {
      margin: 0;
      max-width: 17em; /* ~3 balanced lines at any size — easier to read than one long line */
      text-wrap: balance;
    }
    /* Line reveal: each word rises out of its own mask (about-scene.js plays it per beat) */
    .about-word {
      display: inline-block;
      overflow: clip;
      overflow-clip-margin: 0.1em;
      vertical-align: top;
      padding-bottom: 0.06em;
      margin-bottom: -0.06em;
      color: var(--color-grey-90);
    }
    .about-word > span {
      display: inline-block;
      transform: translateY(110%);
      will-change: transform;
    }
    .about-tv-caption {
      position: absolute;
      z-index: 2;
      left: 50%;
      bottom: 4%;
      translate: -50% 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
      color: var(--color-grey-90);
      text-align: center;
      opacity: 0;
      pointer-events: none;
    }

    /* Website health cards: absolutely placed (positions from the frontmatter), driven by
       about-scene.js — rise in with the second statement, parallax by depth, then drift away. */
    .about-gallery {
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
    }
    .about-tile {
      position: absolute;
      left: var(--x);
      /* inside the band from the card's bottom (+2%) to ~78% of the stage, so the card stays clear */
      top: calc(var(--card-bottom, 45%) + 2% + (76% - var(--card-bottom, 45%)) * var(--y));
      width: max-content;
      margin: 0;
      opacity: 0;
      will-change: transform, opacity;
    }
    /* Website health cards (Figma "2nd Section Floating Cards"): app windows, red "typical audit" →
       brand-blue "after rebuild" (.is-good, set by about-scene.js). --val (set by the script while the
       number counts) fills the tick gauges. */
    .insight {
      --bad: #e5484d;
      --good: var(--color-secondary);
      --state: var(--bad);
      --tick-off: #dee0e0;
    }
    /* Page speed + bounce rate read as health metrics: green when they pass on step 2 */
    .insight.is-kind-score,
    .insight.is-kind-metric {
      --good: #12a150;
    }
    .insight.is-good {
      --state: var(--good);
    }
    .insight-card {
      --val: 0;
      overflow: hidden;
      border: 1px solid #dfdede;
      border-radius: 6px;
      background: var(--color-white);
      box-shadow: 0 18px 40px -22px rgb(0 2 3 / 0.28);
    }
    .insight-bar {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin: 0;
      padding: 0.6875rem 0.75rem;
      background: #ededed;
      color: var(--color-grey-60);
      font-weight: 500;
      line-height: 1.4;
      white-space: nowrap;
    }
    .insight-dots {
      display: flex;
      gap: 4px;
    }
    .insight-dots i {
      width: 9px;
      height: 9px;
      border: 1px solid #bfc2c7;
      border-radius: 50%;
      background: #c4c7c9;
    }
    .insight-body {
      padding: 1rem 1.125rem;
    }
    /* swap pairs: bad text by default, good text with .is-good (crossfade in place) */
    .insight-swap {
      display: grid;
    }
    .insight-swap > b {
      grid-area: 1 / 1;
      font-weight: inherit;
    }
    .insight-when-bad,
    .insight-when-good {
      transition: opacity 0.5s var(--ease-esse), translate 0.6s var(--ease-esse);
    }
    .insight-when-good {
      opacity: 0;
      translate: 0 0.4em;
    }
    .insight.is-good .insight-when-bad {
      opacity: 0;
      translate: 0 -0.4em;
    }
    .insight.is-good .insight-when-good {
      opacity: 1;
      translate: 0 0;
    }

    /* PageSpeed: 72-tick ring, filled clockwise from the top up to --val, fading in along the fill */
    .insight-score {
      position: relative;
      display: grid;
      place-items: center;
      width: 10.75rem; /* 172px window */
      height: 9rem;
      padding: 0;
    }
    .insight-score svg {
      width: 7rem;
      height: 7rem;
      overflow: visible;
    }
    .insight-score line {
      --on: clamp(0, (var(--val) - var(--t) * 100) * 2, 1);
      --r: min(1, var(--t) * 100 / max(var(--val), 1));
      stroke: color-mix(in srgb, var(--state) calc(var(--on) * 100%), var(--tick-off));
      stroke-width: 2.35;
      stroke-linecap: round;
      opacity: calc(1 - var(--on) * 0.76 * (1 - var(--r)));
      transition: stroke 0.6s;
    }
    .insight-num {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      font: 500 2.5rem/1 var(--font-tertiary);
      letter-spacing: -0.09em;
      color: var(--state);
      transition: color 0.6s;
    }
    .insight.is-good .insight-num {
      color: #17171a;
    }

    /* Bounce rate: big number, 41-tick scale filled up to --val, status + range */
    .insight-metric {
      display: grid;
      gap: 1rem;
      width: 16.5rem; /* 264px window */
    }
    .insight-value {
      display: flex;
      align-items: flex-end;
      gap: 0.625rem;
      margin: 0;
    }
    .insight-big {
      display: flex;
      align-items: flex-end;
      gap: 3px;
      font: 500 2.5rem/0.75 var(--font-tertiary);
      letter-spacing: -0.09em;
      color: #17171a;
    }
    .insight-big small {
      font: 700 1.625rem/0.75 var(--font-tertiary);
      letter-spacing: 0;
    }
    .insight-label {
      font: 600 0.875rem/1 var(--font-secondary);
      letter-spacing: -0.02em;
      color: #171a1f;
    }
    .insight-scale {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      height: 1.5rem;
    }
    .insight-scale i {
      --on: clamp(0, (var(--val) + 5 - var(--t) * 100) * 10, 1);
      width: 1.65px;
      height: 13px;
      border-radius: 0.8px;
      background: color-mix(in srgb, var(--state) calc(var(--on) * 100%), var(--tick-off));
      transition: background-color 0.6s;
    }
    .insight-scale i.is-long {
      height: 22px;
    }
    .insight-status {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin: 0;
      font: 600 0.875rem/1 var(--font-secondary);
      color: var(--state);
      transition: color 0.6s;
    }
    .insight-status em {
      font-size: 0.5rem;
      font-style: normal;
      vertical-align: 0.2em;
      margin-right: 0.25rem;
    }
    .insight-range {
      font: 500 0.6875rem/1 var(--font-secondary);
      color: #70737a;
    }

    /* Customer review */
    .insight-review {
      display: grid;
      gap: 0.75rem;
      width: 16.5rem;
    }
    /* Stars change in place, one after another: each star is an outline with a fill on top. On the
       switch, the existing fills shift gold → blue and the missing ones pop in, left to right. */
    .insight-stars {
      --star: #a5670a;
      display: flex;
      gap: 0.12em;
      margin: 0;
      font: 400 1.125rem/1.1 var(--font-secondary);
    }
    .insight.is-good .insight-stars {
      --star: var(--good);
    }
    .insight-star {
      display: inline-grid;
    }
    .insight-star > i {
      grid-area: 1 / 1;
      font-style: normal;
      transition-delay: calc(var(--s) * 130ms);
    }
    .star-o {
      color: var(--star);
      opacity: 0.45;
      transition: color 0.5s var(--ease-esse);
    }
    .star-f {
      color: var(--star);
      opacity: 0;
      scale: 0.3;
      transition: color 0.5s var(--ease-esse), opacity 0.25s ease-out, scale 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .insight:not(.is-good) .insight-star.is-on-bad .star-f,
    .insight.is-good .insight-star.is-on-good .star-f {
      opacity: 1;
      scale: 1;
    }
    @media (prefers-reduced-motion: reduce) {
      .insight-star > i {
        transition: none;
      }
    }
    .insight-quote {
      margin: 0;
      font: 400 0.875rem/1.25 var(--font-secondary);
      letter-spacing: 0;
      color: #171a1f;
    }

    /* Creative design: a mini storefront that re-lays itself — a grey template grid on beat 1 →
       a soft-blue editorial layout on beat 2. Every piece is absolutely placed (Figma 263×128 thumb)
       and moves one after another (.is-good). */
    .insight-design {
      position: relative;
      width: 16.4375rem; /* 263px */
      height: 8rem;
      border-radius: 4px;
      background: #f4f5f5;
      overflow: hidden;
      transition: background-color 0.6s var(--ease-esse);
    }
    .insight-design i {
      position: absolute;
      display: block;
      border-radius: 2px;
      transition-property: left, top, width, height, background-color, opacity;
      transition-duration: 0.9s;
      transition-timing-function: var(--ease-esse);
    }
    /* before: a template grid */
    .s-nav { left: 4.6%; top: 9.4%; width: 23.6%; height: 3.1%; background: #c4c9c9; }
    .s-cart { left: 87%; top: 7.8%; width: 8.4%; height: 5.5%; background: #c4c9c9; }
    .s-p { top: 21%; width: 28.5%; height: 44.5%; background: #e1e5e5; }
    .s-p1 { left: 4.6%; }
    .s-p2 { left: 35.4%; }
    .s-p3 { left: 66.2%; }
    .s-t { top: 71.9%; width: 18.3%; height: 2.7%; background: #c4c9c9; }
    .s-pr { top: 78.9%; width: 8.4%; height: 2.5%; background: #dadede; }
    .s-t1, .s-pr1 { left: 4.6%; }
    .s-t2, .s-pr2 { left: 35.4%; }
    .s-t3, .s-pr3 { left: 66.2%; }
    .s-btn { left: 38.8%; top: 88.3%; width: 22%; height: 5.5%; background: #c4c9c9; }

    /* after: a hero panel with two side tiles (Figma "Storefront thumbnail") */
    .insight.is-good .insight-design { background: var(--color-white); }
    .insight.is-good .s-p1 { left: 0; top: 0; width: 61.2%; height: 99.2%; background: #d9e5ff; transition-delay: 0.05s; }
    .insight.is-good .s-p2 { left: 63.9%; top: 0; width: 35.7%; height: 46.9%; background: #bbd0ff; transition-delay: 0.15s; }
    .insight.is-good .s-p3 { left: 63.9%; top: 52.3%; width: 35.7%; height: 46.9%; background: #93b1ff; transition-delay: 0.22s; }
