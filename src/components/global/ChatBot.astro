---
/**
 * Quick-call chat — a 👋 launcher fixed bottom-right that opens a small scripted chat to request a
 * 15-minute call (day → time → email). The wave is the system emoji, so Apple devices show Apple's.
 * Hidden while any [data-chat-hide] element (the hero, the footer) is on screen, and on phones while
 * the cookie banner is up. No booking backend yet: the request is fired as a `uniflow:enquiry`
 * event (source "chat"), like the contact form, and the copy says we'll confirm by email.
 *
 * UNDO: delete the <ChatBot /> line (and its import) in src/layouts/Layout.astro.
 */
---

<div class="cb" data-chat hidden>
  <div class="cb-panel" id="cb-panel" role="dialog" aria-modal="false" aria-labelledby="cb-title" data-chat-panel>
    <div class="cb-bar">
      <span class="cb-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <p id="cb-title" class="text-11">QUICK CALL · UNIFLOW</p>
      <button class="cb-close" type="button" aria-label="Close chat" data-chat-close>
        <svg viewBox="0 0 12 12" width="12" height="12" fill="none" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.2" /></svg>
      </button>
    </div>
    <div class="cb-head">
      <span class="cb-avatar" aria-hidden="true">👋</span>
      <div>
        <p class="cb-name">Uniflow studio</p>
        <p class="cb-status text-11"><i aria-hidden="true"></i>USUALLY REPLIES WITHIN A DAY</p>
      </div>
    </div>
    <div class="cb-log" role="log" aria-live="polite" data-chat-log data-lenis-prevent></div>
    <div class="cb-actions" data-chat-actions></div>
  </div>

  <button class="cb-launch" type="button" aria-expanded="false" aria-controls="cb-panel" aria-label="Book a quick call" data-chat-launch>
    <span class="cb-emoji" aria-hidden="true">👋</span>
    <span class="cb-online" aria-hidden="true"></span>
  </button>
  <p class="cb-hint text-11" aria-hidden="true" data-chat-hint>QUICK CALL?</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-chat]").forEach((root) => {
    const panel = root.querySelector<HTMLElement>("[data-chat-panel]")!;
    const launch = root.querySelector<HTMLButtonElement>("[data-chat-launch]")!;
    const close = root.querySelector<HTMLButtonElement>("[data-chat-close]")!;
    const log = root.querySelector<HTMLElement>("[data-chat-log]")!;
    const actions = root.querySelector<HTMLElement>("[data-chat-actions]")!;
    const hint = root.querySelector<HTMLElement>("[data-chat-hint]")!;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    root.hidden = false;

    // ---- visibility: hide over the hero / footer (and the cookie banner on phones) ----
    // A sticky blocker (the hero stays pinned while About slides over it) is only "showing" down to
    // where the next section's top edge has reached, so measure what is actually uncovered.
    const blockers = [...document.querySelectorAll<HTMLElement>("[data-chat-hide]")];
    const uncovered = (el: HTMLElement) => {
      const r = el.getBoundingClientRect(), vh = innerHeight;
      let bottom = r.bottom;
      const next = el.nextElementSibling;
      if (next && getComputedStyle(el).position === "sticky") bottom = Math.min(bottom, next.getBoundingClientRect().top);
      return Math.max(0, Math.min(bottom, vh) - Math.max(r.top, 0)) > vh * 0.12;
    };
    let blocked = false, raf = 0;
    const measure = () => { raf = 0; const b = blockers.some(uncovered); if (b !== blocked) { blocked = b; sync(); } };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(measure); };
    addEventListener("scroll", onScroll, { passive: true });
    document.body.addEventListener("scroll", onScroll, { passive: true }); // touch body-scroller
    addEventListener("resize", onScroll);
    blocked = blockers.some(uncovered);
    const banner = document.querySelector<HTMLElement>("[data-cookie-banner]");
    const phone = matchMedia("(width < 40rem)");
    function sync() {
      const bannerUp = !!banner && !banner.hidden && phone.matches;
      const away = (blocked || bannerUp) && !root.classList.contains("is-open");
      root.classList.toggle("is-away", away);
      launch.tabIndex = away ? -1 : 0;
    }
    if (banner) new MutationObserver(sync).observe(banner, { attributes: true, attributeFilter: ["hidden"] });
    sync();
    // the hint nudges once, a few seconds after the launcher first shows
    let hinted = false;
    const nudge = () => {
      if (hinted || root.classList.contains("is-away") || root.classList.contains("is-open")) return;
      hinted = true; root.classList.add("is-hinting");
      setTimeout(() => root.classList.remove("is-hinting"), 4200);
    };
    setInterval(nudge, 6000);

    // ---- chat ----
    const wait = (ms: number) => new Promise((r) => setTimeout(r, reduce ? 0 : ms));
    const scrollDown = () => log.scrollTo({ top: log.scrollHeight, behavior: reduce ? "auto" : "smooth" });
    function bubble(text: string, from: "bot" | "me") {
      const p = document.createElement("p");
      p.className = `cb-msg is-${from}`;
      p.textContent = text;
      log.append(p); scrollDown();
    }
    async function say(...lines: string[]) {
      for (const line of lines) {
        const t = document.createElement("p");
        t.className = "cb-typing"; t.setAttribute("aria-label", "Typing");
        t.innerHTML = "<i></i><i></i><i></i>";
        log.append(t); scrollDown();
        await wait(520 + Math.min(700, line.length * 12));
        t.remove(); bubble(line, "bot");
      }
    }
    function choices(list: { label: string; value: string }[], pick: (v: string, label: string) => void) {
      actions.replaceChildren(...list.map(({ label, value }) => {
        const b = document.createElement("button");
        b.type = "button"; b.className = "cb-chip text-11"; b.textContent = label;
        b.addEventListener("click", () => { actions.replaceChildren(); bubble(label, "me"); pick(value, label); });
        return b;
      }));
      (actions.firstElementChild as HTMLElement | null)?.focus({ preventScroll: true });
    }
    function ask(placeholder: string, type: string, submit: (v: string) => void) {
      const f = document.createElement("form");
      f.className = "cb-form";
      f.innerHTML = `<input class="text-12" name="v" type="${type}" required placeholder="${placeholder}" aria-label="${placeholder}"><button type="submit" class="cb-send" aria-label="Send"><svg viewBox="0 0 12 12" width="12" height="12" fill="none"><path d="M1 6h10M6.5 1.5 11 6l-4.5 4.5" stroke="currentColor" stroke-width="1.2"/></svg></button>`;
      f.addEventListener("submit", (e) => {
        e.preventDefault();
        const v = (f.elements.namedItem("v") as HTMLInputElement).value.trim();
        if (!v) return;
        actions.replaceChildren(); bubble(v, "me"); submit(v);
      });
      actions.replaceChildren(f);
      f.querySelector("input")!.focus({ preventScroll: true });
    }
    // next five weekdays
    const days = (() => {
      const out: { label: string; value: string }[] = [];
      const d = new Date();
      while (out.length < 5) {
        d.setDate(d.getDate() + 1);
        if (d.getDay() === 0 || d.getDay() === 6) continue;
        out.push({ label: d.toLocaleDateString("en-GB", { weekday: "short", day: "2-digit", month: "short" }).toUpperCase(), value: d.toISOString().slice(0, 10) });
      }
      return out;
    })();
    const times = ["10:00", "12:30", "15:00", "17:30"].map((t) => ({ label: `${t} IST`, value: t }));
    const request: Record<string, string> = {};
    const nice = (s: string) => s.toLowerCase().replace(/\b[a-z]/g, (c) => c.toUpperCase()); // "TUE 24 NOV" → "Tue 24 Nov"

    async function start() {
      log.replaceChildren(); actions.replaceChildren();
      await say("Hey! 👋 Got a website on your mind?", "Grab a free 15-minute call with the studio — no pitch, just honest answers.");
      choices([{ label: "BOOK A 15-MIN CALL", value: "call" }, { label: "START A PROJECT", value: "project" }, { label: "JUST BROWSING", value: "browse" }], async (v) => {
        if (v === "project") { await say("Perfect — the project form has everything we need."); location.href = "/contact"; return; }
        if (v === "browse") { await say("Take your time! I'll be right here if you need us."); choices([{ label: "ACTUALLY, LET'S TALK", value: "again" }], () => start()); return; }
        await say("Nice. Which day works for you?");
        choices(days, async (day, dayLabel) => {
          request.day = day;
          await say(`${nice(dayLabel)} it is. Pick a time:`);
          choices(times, async (time) => {
            request.time = time;
            await say("Last thing — where should we send the invite?");
            ask("you@company.com", "email", async (email) => {
              request.email = email;
              root.dispatchEvent(new CustomEvent("uniflow:enquiry", { bubbles: true, detail: { source: "chat", ...request } }));
              await say(`Got it — we'll confirm ${nice(dayLabel)} at ${time} IST by email to ${email} shortly.`, "Talk soon! ✌️");
              choices([{ label: "START OVER", value: "again" }], () => start());
            });
          });
        });
      });
    }

    let started = false;
    function setOpen(open: boolean) {
      root.classList.toggle("is-open", open);
      launch.setAttribute("aria-expanded", String(open));
      root.classList.remove("is-hinting"); hinted = true;
      if (open && !started) { started = true; start(); }
      if (open) (actions.firstElementChild as HTMLElement | null)?.focus({ preventScroll: true });
      else launch.focus({ preventScroll: true });
      sync();
    }
    launch.addEventListener("click", () => setOpen(!root.classList.contains("is-open")));
    close.addEventListener("click", () => setOpen(false));
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && root.classList.contains("is-open")) setOpen(false); });
  });
</script>

<style>
  @layer components {
    .cb {
      position: fixed;
      right: 1.5rem;
      bottom: 1.5rem;
      z-index: 44; /* below the cookie banner (45) and the navbar/menu (50) */
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.75rem;
      pointer-events: none;
      transition: opacity 0.45s var(--ease-esse), translate 0.6s var(--ease-esse);
    }
    .cb.is-away {
      opacity: 0;
      translate: 0 1.5rem;
    }
    .cb.is-away * {
      pointer-events: none !important;
    }

    /* ---- launcher: the wave ---- */
    .cb-launch {
      position: relative;
      display: grid;
      place-items: center;
      width: 3.75rem;
      height: 3.75rem;
      border: 1px solid #dfdede;
      border-radius: 50%;
      background: var(--color-white);
      box-shadow: 0 18px 36px -18px rgb(0 2 3 / 0.45);
      cursor: pointer;
      pointer-events: auto;
      transition: scale 0.45s var(--ease-esse), box-shadow 0.45s var(--ease-esse);
    }
    .cb-launch:hover {
      scale: 1.06;
      box-shadow: 0 22px 40px -18px rgb(0 2 3 / 0.5);
    }
    .cb-launch:focus-visible {
      outline: 2px solid var(--color-secondary);
      outline-offset: 3px;
    }
    .cb-emoji {
      font-size: 1.75rem;
      line-height: 1;
      transform-origin: 70% 80%;
      animation: cb-wave 2.4s ease-in-out infinite;
    }
    .cb-online {
      position: absolute;
      right: 0.25rem;
      top: 0.25rem;
      width: 9px;
      height: 9px;
      border: 2px solid var(--color-white);
      background: var(--color-accent);
    }
    .cb.is-open .cb-emoji {
      animation: none;
    }

    /* one-time nudge beside the launcher */
    .cb-hint {
      position: absolute;
      right: 4.5rem;
      bottom: 1.125rem;
      margin: 0;
      padding: 0.5rem 0.75rem;
      background: var(--color-grey-90);
      color: var(--color-white);
      white-space: nowrap;
      opacity: 0;
      translate: 0.5rem 0;
      transition: opacity 0.4s var(--ease-esse), translate 0.4s var(--ease-esse);
    }
    .cb.is-hinting .cb-hint {
      opacity: 1;
      translate: 0 0;
    }

    /* ---- panel: the site's window chrome ---- */
    .cb-panel {
      display: flex;
      flex-direction: column;
      width: min(22rem, calc(100vw - 2rem));
      height: min(32rem, calc(100svh - 8rem));
      overflow: hidden;
      border: 1px solid #dfdede;
      border-radius: 6px;
      background: var(--color-white);
      box-shadow: 0 30px 60px -30px rgb(0 2 3 / 0.45);
      transform-origin: 100% 100%;
      opacity: 0;
      scale: 0.92;
      visibility: hidden;
      transition: opacity 0.35s var(--ease-esse), scale 0.45s var(--ease-esse), visibility 0s 0.45s;
    }
    .cb.is-open .cb-panel {
      opacity: 1;
      scale: 1;
      visibility: visible;
      pointer-events: auto;
      transition: opacity 0.35s var(--ease-esse), scale 0.45s var(--ease-esse), visibility 0s;
    }
    .cb-bar {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.625rem 0.75rem;
      background: #ededed;
    }
    .cb-bar p {
      flex: 1;
      margin: 0;
      color: var(--color-grey-60);
    }
    .cb-dots {
      display: flex;
      gap: 4px;
    }
    .cb-dots i {
      width: 8px;
      height: 8px;
      border: 1px solid #bfc2c7;
      border-radius: 50%;
      background: #c4c7c9;
    }
    .cb-close {
      display: grid;
      place-items: center;
      width: 1.5rem;
      height: 1.5rem;
      border: 0;
      background: none;
      color: var(--color-grey-70);
      cursor: pointer;
    }
    .cb-close:hover {
      color: var(--color-grey-90);
    }
    .cb-head {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.875rem 1rem;
      border-bottom: 1px dashed var(--color-border);
    }
    .cb-head p {
      margin: 0;
    }
    .cb-avatar {
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 50%;
      background: #f2f3f3;
      font-size: 1.25rem;
    }
    .cb-name {
      font: 500 0.9375rem/1.2 var(--font-secondary);
      letter-spacing: -0.02em;
      color: var(--color-grey-90);
    }
    .cb-status {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      margin-top: 0.25rem !important;
      color: var(--color-grey-50);
    }
    .cb-status i {
      width: 6px;
      height: 6px;
      background: var(--color-accent);
    }

    .cb-log {
      display: flex;
      flex: 1;
      flex-direction: column;
      gap: 0.5rem;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 1rem;
      background-image: var(--line-grid);
      background-size: 12px 12px;
    }
    .cb-log :global(.cb-msg) {
      max-width: 85%;
      margin: 0;
      padding: 0.625rem 0.75rem;
      font: 500 0.875rem/1.4 var(--font-secondary);
      letter-spacing: -0.01em;
      animation: cb-in 0.4s var(--ease-esse) both;
    }
    .cb-log :global(.cb-msg.is-bot) {
      align-self: flex-start;
      border: 1px solid #e4e6e6;
      border-radius: 2px 10px 10px 10px;
      background: var(--color-white);
      color: var(--color-grey-90);
    }
    .cb-log :global(.cb-msg.is-me) {
      align-self: flex-end;
      border-radius: 10px 2px 10px 10px;
      background: var(--color-secondary);
      color: var(--color-white);
      font-family: var(--font-tertiary);
      font-size: 0.75rem;
    }
    .cb-log :global(.cb-typing) {
      display: flex;
      gap: 3px;
      align-self: flex-start;
      margin: 0;
      padding: 0.75rem;
      border: 1px solid #e4e6e6;
      border-radius: 2px 10px 10px 10px;
      background: var(--color-white);
    }
    .cb-log :global(.cb-typing i) {
      width: 5px;
      height: 5px;
      background: var(--color-secondary);
      animation: cb-blink 0.9s steps(1) infinite;
    }
    .cb-log :global(.cb-typing i:nth-child(2)) { animation-delay: 0.15s; }
    .cb-log :global(.cb-typing i:nth-child(3)) { animation-delay: 0.3s; }

    .cb-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.375rem;
      padding: 0.75rem;
      border-top: 1px solid #ededed;
    }
    .cb-actions:empty {
      display: none;
    }
    .cb-actions :global(.cb-chip) {
      padding: 0.5rem 0.625rem;
      border: 1px solid var(--color-border);
      background: var(--color-white);
      color: var(--color-grey-90);
      cursor: pointer;
      transition: background-color 0.25s, color 0.25s, border-color 0.25s;
    }
    .cb-actions :global(.cb-chip:hover),
    .cb-actions :global(.cb-chip:focus-visible) {
      border-color: var(--color-grey-90);
      background: var(--color-grey-90);
      color: var(--color-white);
      outline: none;
    }
    .cb-actions :global(.cb-form) {
      display: flex;
      flex: 1;
      gap: 0.375rem;
    }
    .cb-actions :global(.cb-form input) {
      flex: 1;
      min-width: 0;
      padding: 0.625rem 0.75rem;
      border: 1px solid var(--color-border);
      color: var(--color-grey-90);
      outline: none;
    }
    .cb-actions :global(.cb-form input:focus) {
      border-color: var(--color-secondary);
    }
    .cb-actions :global(.cb-send) {
      display: grid;
      place-items: center;
      width: 2.5rem;
      border: 0;
      background: var(--color-grey-90);
      color: var(--color-white);
      cursor: pointer;
    }

    @media (width < 40rem) {
      .cb {
        right: 1rem;
        bottom: 1rem;
      }
      .cb-launch {
        width: 3.25rem;
        height: 3.25rem;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .cb-emoji,
      .cb-log :global(.cb-msg) {
        animation: none;
      }
    }
  }

  @keyframes cb-wave {
    0%, 60%, 100% { rotate: 0deg; }
    10%, 30% { rotate: 16deg; }
    20%, 40% { rotate: -8deg; }
    50% { rotate: 6deg; }
  }
  @keyframes cb-in {
    from { opacity: 0; translate: 0 6px; }
  }
  @keyframes cb-blink {
    50% { opacity: 0.25; }
  }
</style>
