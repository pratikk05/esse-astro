---
/**
 * Preloader — dither overlay that dissolves out of its halftone "gap" (where the hero gradient already
 * shows through) to reveal the page. Chrome mirrors the hero: grid lines + a bottom status bar.
 * Based on the approved "dither-logo-loader" concept, adapted to the site:
 *  - waits for fonts + page load (min 0.9s, max 5s) instead of a fixed timer
 *  - grey-100 overlay; status bar: teal live square + "UI IS LOADING", [ 064 ] counter, pixel progress cells
 *  - all dots are drawn as batched paths (one fill per layer) so the dissolve holds 60fps
 * Elements marked data-reveal lift in while the last cells clear; data-reveal="fade" only fades
 * (used on the header, whose fixed CTA must not get a transformed ancestor).
 * The same canvas is the page transition: leaving a page closes the dither onto the seam, the next
 * page opens it again (short, no loader marks). Layout decides the mode inline in <head>:
 *   data-loader="load"  → preloader (first visit / reload of a page with `preloader`)
 *   data-loader="enter" → arriving through an internal link, or Back/Forward
 *   nothing             → pages without a preloader opened directly
 * Back/Forward: the browser leaves the old page without running its cover, so
 *  - a cross-document View Transition (@view-transition below) crossfades the old page into this
 *    page's first frame, which is the solid ink overlay — then the box reveal opens it;
 *  - pages going into the back/forward cache are covered on `pagehide`, so they come back covered
 *    and open with the same reveal instead of flashing.
 * html.is-loading is only added by that script, so nothing is hidden when JavaScript is off.
 */
---

<div id="preloader" class="preloader" aria-hidden="true">
  <canvas class="preloader-canvas"></canvas>
</div>

<style is:global>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
    background: var(--color-grey-100);
    cursor: progress;
  }
  html.is-loading .preloader {
    display: block;
    /* Safety net: if the script never runs, the overlay still clears itself. */
    animation: preloader-failsafe 0.6s ease 8s forwards;
  }
  .preloader.is-running {
    background: transparent;
    animation: none !important;
  }
  .preloader-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Cross-document View Transitions (Chrome/Edge 126+, Safari 18.2+; ignored elsewhere): every
     navigation, including Back/Forward, crossfades the old page into the new page's ink overlay. */
  @view-transition {
    navigation: auto;
  }
  /* No white flash: the old page stays fully opaque underneath (no fade, no scale that would expose
     the white document background) and the new page — whose first frame is the solid ink overlay —
     fades in over it with normal blending (Chrome's default crossfade uses plus-lighter, which
     brightens both layers toward white mid-transition). */
  ::view-transition-image-pair(root) {
    isolation: auto;
  }
  ::view-transition-old(root),
  ::view-transition-new(root) {
    mix-blend-mode: normal;
  }
  ::view-transition-old(root) {
    animation: none;
  }
  ::view-transition-new(root) {
    animation: page-in 0.38s cubic-bezier(0.65, 0, 0.35, 1) both;
  }
  @keyframes page-in {
    from { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none;
    }
  }
  @keyframes preloader-failsafe {
    to { opacity: 0; visibility: hidden; }
  }

  /* Hero content: hidden under the overlay, then lifts into focus. */
  html.is-loading [data-reveal] {
    opacity: 0;
  }
  /* The hero headline stays opaque under the (solid) overlay and only lifts + unblurs into focus:
     visually the same, but browsers can register it as the page's main content (LCP) right away
     instead of only after the preloader — a large PageSpeed win. */
  html.is-loading [data-reveal="lift"] {
    opacity: 1;
  }
  html.is-loading [data-reveal]:not([data-reveal="fade"]) {
    transform: translate3d(0, 22px, 0);
    filter: blur(2.5px);
  }
  html.is-revealing [data-reveal] {
    transition:
      opacity 0.9s var(--ease-esse),
      transform 1.1s var(--ease-esse),
      filter 1s var(--ease-esse);
    transition-delay: calc(var(--reveal-order, 0) * 70ms);
    will-change: opacity, transform, filter;
  }
  /* Fade-only (the navbar): transform/filter here would make the header a containing block and the
     fixed START A PROJECT + menu buttons would scroll away during the intro. */
  html.is-revealing [data-reveal="fade"] {
    will-change: opacity;
  }
  @media (prefers-reduced-motion: reduce) {
    html.is-loading [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const wrap = document.getElementById("preloader");
  const canvas = wrap?.querySelector("canvas");

  if (wrap && canvas) {
    const preloader: HTMLElement = wrap; // non-null for the hoisted functions below
    const mode = root.dataset.loader; // "load" (preloader) | "enter" (page transition) | undefined
    const ctx = canvas.getContext("2d", { alpha: true })!;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const INK = "#000203"; // --color-grey-100

    // 8×8 Bayer matrix: the ordered-dither texture of the dissolve.
    const bayer8 = [
      [0, 48, 12, 60, 3, 51, 15, 63], [32, 16, 44, 28, 35, 19, 47, 31],
      [8, 56, 4, 52, 11, 59, 7, 55], [40, 24, 36, 20, 43, 27, 39, 23],
      [2, 50, 14, 62, 1, 49, 13, 61], [34, 18, 46, 30, 33, 17, 45, 29],
      [10, 58, 6, 54, 9, 57, 5, 53], [42, 26, 38, 22, 41, 25, 37, 21],
    ];
    const hash2 = (x: number, y: number) => {
      const n = Math.sin(x * 127.1 + y * 311.7 + 19.19) * 43758.5453123;
      return n - Math.floor(n);
    };
    const smooth01 = (t: number) => t * t * (3 - 2 * t);
    const clamp01 = (t: number) => Math.max(0, Math.min(1, t));
    const valueNoise = (u: number, v: number, sx: number, sy: number) => {
      const x = u * sx, y = v * sy, x0 = Math.floor(x), y0 = Math.floor(y);
      const fx = smooth01(x - x0), fy = smooth01(y - y0);
      const a = hash2(x0, y0), b = hash2(x0 + 1, y0), c = hash2(x0, y0 + 1), d = hash2(x0 + 1, y0 + 1);
      const top = a + (b - a) * fx;
      return top + (c + (d - c) * fx - top) * fy;
    };

    let W = 0, H = 0, dpr = 1, step = 9, cols = 0, rows = 0;
    let thresholds = new Float32Array(0);
    let seamT: number | null = null; // time the dissolve froze the gap's shape (null = flat page-transition seam)

    // Centre line of the halftone "gap" at time t (seconds) — the same curve drawCurrent() wobbles along.
    const gapBase = () => H * 0.44;
    const gapBand = () => H * (W < 700 ? 0.105 : 0.125);
    function gapCentre(u: number, t: number) {
      const band = gapBand(), n1 = valueNoise(u, 0.5, 5.5, 3.5);
      return gapBase() + Math.sin(u * 7.5 + t * 0.68) * band * 0.29 + Math.sin(u * 15.2 - t * 0.42 + n1 * 2.2) * band * 0.13;
    }

    function buildThresholds() {
      for (let gx = 0; gx < cols; gx++) {
        const u = (gx + 0.5) / cols;
        const c = seamT === null ? H / 2 : gapCentre(u, seamT);
        for (let gy = 0; gy < rows; gy++) {
          const v = (gy + 0.5) / rows, y = v * H;
          // Distance from the gap, normalised to the far edge on that side: the gap opens first.
          const d = Math.abs(y - c) / Math.max(1, y < c ? c : H - c);
          const t =
            0.006 +
            d * 0.65 +
            (valueNoise(u, v, 4.2, 3.2) - 0.5) * 0.15 +
            (valueNoise(u, v, 15, 11) - 0.5) * 0.085 +
            (hash2(gx + 41, gy + 83) - 0.5) * 0.045 +
            (bayer8[gy % 8][gx % 8] / 63 - 0.5) * 0.045 +
            Math.sin(u * 8.2 + v * 2.6) * 0.038 +
            Math.sin(u * 16.5 - v * 5.2) * 0.018;
          thresholds[gy * cols + gx] = Math.max(0.015, Math.min(0.985, t));
        }
      }
    }

    function resize() {
      W = innerWidth;
      H = innerHeight;
      dpr = Math.min(devicePixelRatio || 1, 1.5);
      canvas!.width = Math.round(W * dpr);
      canvas!.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      step = W < 700 ? 10 : 12; // one cell = one box of the site's 12px line grid
      cols = Math.ceil(W / step);
      rows = Math.ceil(H / step);
      thresholds = new Float32Array(cols * rows);
      buildThresholds();
    }

    /** Living halftone current: transparent holes that let the hero gradient show through. */
    // Per-dot values that never change between frames (noise, hash) are computed once per size and
    // reused — the dissolve looks identical but costs a fraction of the CPU per frame.
    let cache: { key: string; nCols: number; nRows: number; n1: Float32Array; n2: Float32Array; h: Float32Array } | null = null;
    function currentCache(spacing: number, band: number) {
      const nCols = Math.ceil(W / spacing) + 3, nRows = Math.ceil((band * 2) / spacing) + 2;
      const key = `${W}x${H}`;
      if (cache && cache.key === key) return cache;
      const size = nCols * nRows;
      const n1 = new Float32Array(size), n2 = new Float32Array(size), h = new Float32Array(size);
      for (let gy = 0; gy < nRows; gy++) {
        const v = (gy * spacing) / (band * 2);
        for (let c = 0; c < nCols; c++) {
          const gx = c - 1, u = (gx * spacing) / Math.max(1, W), i = gy * nCols + c;
          n1[i] = valueNoise(u, v, 5.5, 3.5);
          n2[i] = valueNoise(u, v, 17, 10);
          h[i] = hash2(gx + 21, gy + 53);
        }
      }
      return (cache = { key, nCols, nRows, n1, n2, h });
    }

    function drawCurrent(now: number, strength: number) {
      const t = now * 0.001, mobile = W < 700;
      const spacing = mobile ? 8.5 : 10.5;
      const baseY = gapBase(), band = gapBand();
      const { nCols, nRows, n1: N1, n2: N2, h: HASH } = currentCache(spacing, band);
      // Three opacity buckets → three fills instead of one fill per dot.
      const paths = [new Path2D(), new Path2D(), new Path2D()];
      for (let gy = 0; gy < nRows; gy++) {
        const y = baseY - band + gy * spacing;
        const rowWobble = Math.sin(t + gy * 0.21) * 0.8;
        for (let c = 0; c < nCols; c++) {
          const gx = c - 1, i = gy * nCols + c;
          const x = gx * spacing, u = x / Math.max(1, W);
          const n1 = N1[i];
          const centre = baseY + Math.sin(u * 7.5 + t * 0.68) * band * 0.29 + Math.sin(u * 15.2 - t * 0.42 + n1 * 2.2) * band * 0.13;
          const envelope = Math.max(0, 1 - Math.abs(y - centre) / (band * (0.44 + n1 * 0.72)));
          if (envelope <= 0.12 || HASH[i] >= envelope * 0.78) continue;
          const pulse = 0.86 + 0.14 * (0.5 + 0.5 * Math.sin(t * 1.25 + gx * 0.06 + gy * 0.12));
          const r = ((mobile ? 0.72 : 0.86) + envelope * (mobile ? 0.8 : 1.05) + N2[i] * 0.28) * pulse * strength;
          const px = x + rowWobble, py = y + Math.sin(t * 0.7 + gx * 0.045) * 1.4;
          const path = paths[envelope > 0.66 ? 2 : envelope > 0.38 ? 1 : 0];
          path.rect(px - r, py - r, r * 2, r * 2); // square dots, matching the site's box grid
        }
      }
      ctx.globalCompositeOperation = "destination-out";
      [0.56, 0.7, 0.84].forEach((alpha, i) => {
        ctx.globalAlpha = alpha;
        ctx.fill(paths[i]);
      });
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = "source-over";
    }

    /**
     * Loader chrome in the site's UI language (mirrors the hero): faint 5-column grid lines, a hairline
     * status bar at the bottom — teal live square + "UI IS LOADING" · [ 064 ] counter · pixel progress cells.
     */
    function drawChrome(now: number, percent: number, strength: number) {
      const mobile = W < 700, pad = mobile ? 16 : 32;
      ctx.fillStyle = `rgba(255,255,255,${0.07 * strength})`; // --color-line-on-dark
      for (let k = 1; k < 5; k++) ctx.fillRect(Math.round((W * k) / 5), 0, 1, H);
      const barTop = H - (mobile ? 104 : 88);
      ctx.fillRect(0, barTop, W, 1);

      ctx.font = "600 12px Jetbrainsmono, ui-monospace, monospace"; // text-12
      if ("letterSpacing" in ctx) (ctx as any).letterSpacing = "-0.12px";
      ctx.textBaseline = "middle";
      const rowY = barTop + (mobile ? 30 : 36);

      // Left: teal "live" square + soft ping (same as the hero's AVAILABLE square)
      const sq = 4, sx = pad, sy = Math.round(rowY - sq / 2);
      const ping = (now % 1600) / 1600;
      ctx.strokeStyle = `rgba(27,219,206,${(1 - ping) * 0.6 * strength})`;
      ctx.lineWidth = 1;
      const pr = sq / 2 + ping * 7;
      ctx.strokeRect(sx + sq / 2 - pr, sy + sq / 2 - pr, pr * 2, pr * 2);
      ctx.fillStyle = `rgba(27,219,206,${strength})`; // --color-accent
      ctx.fillRect(sx, sy, sq, sq);
      ctx.textAlign = "left";
      ctx.fillStyle = `rgba(227,232,232,${strength})`; // grey-10
      ctx.fillText(percent >= 99.5 ? "UI READY" : "UI IS LOADING", sx + 14, rowY);

      // Centre (desktop) / under the label (mobile): counter
      const counter = `[ ${String(Math.round(percent)).padStart(3, "0")} ]`;
      ctx.fillStyle = `rgba(146,156,156,${strength})`; // grey-40
      if (mobile) { ctx.textAlign = "left"; ctx.fillText(counter, sx + 14, rowY + 24); }
      else { ctx.textAlign = "center"; ctx.fillText(counter, W / 2, rowY); }

      // Right: pixel progress cells
      const cells = mobile ? 12 : 16, cs = 6, gap = 3, total = cells * cs + (cells - 1) * gap;
      const cx0 = W - pad - total, filled = (percent / 100) * cells;
      for (let i = 0; i < cells; i++) {
        const f = clamp01(filled - i);
        ctx.fillStyle = `rgba(255,255,255,${(0.14 + 0.86 * f) * strength})`;
        ctx.fillRect(cx0 + i * (cs + gap), Math.round(rowY - cs / 2), cs, cs);
      }
    }

    function draw(p: number, now: number, percent: number, marks = true) {
      ctx.globalCompositeOperation = "source-over";
      ctx.globalAlpha = 1;
      ctx.clearRect(0, 0, W, H);
      ctx.fillStyle = INK;
      ctx.fillRect(0, 0, W, H);
      // The loader marks ease out as the seam starts to open.
      const strength = marks ? 1 - smooth01(clamp01(p / 0.35)) : 0;
      if (!marks) {
        // page transition: plain ink, no loader marks
      } else if (strength > 0.01) {
        drawCurrent(now, 0.35 + 0.65 * strength);
        drawChrome(now, percent, strength);
      } else {
        drawCurrent(now, 0.35);
      }
      if (p <= 0) return;
      // Dither cells open as growing square boxes (like the CTA / About→Stats reveals) — one path, one fill.
      const holes = new Path2D();
      for (let gy = 0; gy < rows; gy++) {
        const y = gy * step + step * 0.5;
        for (let gx = 0; gx < cols; gx++) {
          const th = thresholds[gy * cols + gx];
          if (p <= th) continue;
          // Half-size grows from a small dot to just past the box edge, so neighbours merge seamlessly.
          const h = Math.max(0.5, step * 0.51 * Math.pow(smooth01((p - th) / (1 - th)), 0.72));
          const x = gx * step + step * 0.5;
          holes.rect(x - h, y - h, h * 2, h * 2);
        }
      }
      ctx.globalCompositeOperation = "destination-out";
      ctx.fill(holes);
      ctx.globalCompositeOperation = "source-over";
    }

    const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const lenis = () => (window as any).lenis;
    let raf = 0;
    const show = () => {
      preloader.style.display = "block";
      preloader.classList.add("is-running"); // the canvas paints the ink; holes show the page
    };
    const hide = () => {
      cancelAnimationFrame(raf);
      preloader.style.display = "";
      preloader.classList.remove("is-running");
    };
    addEventListener("resize", () => preloader.style.display === "block" && resize());

    /**
     * Reveal: dither opens from the centre seam.
     * marks = preloader (halftone current, indicator, counter, waits for the page to load);
     * without marks it is the short page-transition entrance.
     */
    function reveal(marks: boolean) {
      seamT = null;
      const MIN_HOLD = reduce ? 100 : marks ? 900 : 60;
      const MAX_HOLD = marks ? 5000 : 1200;
      const DISSOLVE = reduce ? 250 : marks ? 2300 : 1250;
      let loaded = marks ? 0 : 1; // 0 → 1: fonts (0.5) + window load (1)
      let shown = 0, start = 0, dissolveAt = 0, done = false, revealed = false, last = 0;
      if (marks) {
        document.fonts?.ready.then(() => (loaded = Math.max(loaded, 0.5)));
        const onLoad = () => (loaded = 1);
        if (document.readyState === "complete") onLoad();
        else addEventListener("load", onLoad, { once: true });
      }
      // Preloader always opens on the hero; some browsers restore scroll after first paint.
      const toTop = () => {
        if (!marks || done) return;
        if (scrollY) scrollTo(0, 0);
        lenis()?.scrollTo(0, { immediate: true, force: true });
      };
      toTop();
      addEventListener("load", toTop, { once: true });
      addEventListener("pageshow", toTop, { once: true });

      function liftContent() {
        if (revealed) return;
        revealed = true;
        root.classList.add("is-revealing");
        root.classList.remove("is-loading");
      }
      function finish() {
        if (done) return;
        done = true;
        liftContent();
        hide();
        delete root.dataset.loader;
        preloader.removeEventListener("click", finish);
        lenis()?.start();
        setTimeout(() => root.classList.remove("is-revealing"), 1800);
        document.dispatchEvent(new CustomEvent("uniflow:loaded"));
      }
      function frame(now: number) {
        if (done) return;
        if (!start) start = last = now;
        const dt = Math.min(64, now - last);
        last = now;
        if (marks && scrollY) toTop();
        lenis()?.stop(); // keep the page still under the overlay
        const elapsed = now - start;
        if (!dissolveAt) {
          // Counter chases the real load state, capped until the dissolve begins.
          const target = Math.min(99, Math.max(loaded * 100, (elapsed / MAX_HOLD) * 100));
          shown += (target - shown) * (1 - Math.exp(-dt / 220));
          if ((loaded >= 1 && elapsed >= MIN_HOLD && (!marks || shown > 96)) || elapsed >= MAX_HOLD) {
            dissolveAt = now;
            if (marks) { seamT = now * 0.001; buildThresholds(); } // open from the visible gap
          }
        } else {
          shown += (100 - shown) * (1 - Math.exp(-dt / 90));
        }
        const raw = dissolveAt ? clamp01((now - dissolveAt) / DISSOLVE) : 0;
        if (raw >= (marks ? 0.5 : 0.3)) liftContent();
        draw(easeInOut(raw), now, shown, marks);
        if (raw < 1) raf = requestAnimationFrame(frame);
        else finish();
      }
      resize();
      draw(0, performance.now(), 0, marks);
      show();
      if (marks) preloader.addEventListener("click", finish); // click to skip
      raf = requestAnimationFrame(frame);
    }

    /** Cover: the same dither closes back onto the seam, then the browser navigates. */
    function leave(url: string) {
      seamT = null;
      try {
        sessionStorage.setItem("uniflow:transition", "1");
      } catch {}
      if (reduce) return void (location.href = url);
      const DURATION = 780;
      let start = 0;
      lenis()?.stop();
      resize();
      draw(1, performance.now(), 0, false);
      show();
      preloader.style.cursor = "default";
      const frame = (now: number) => {
        if (!start) start = now;
        const raw = clamp01((now - start) / DURATION);
        draw(1 - easeInOut(raw), now, 0, false);
        if (raw < 1) return void (raf = requestAnimationFrame(frame));
        preloader.classList.remove("is-running"); // solid ink while the next page loads
        location.href = url;
      };
      raf = requestAnimationFrame(frame);
    }
    (window as any).uniflowNavigate = leave;

    // Internal links to another page play the cover first.
    document.addEventListener("click", (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const link = (event.target as Element | null)?.closest?.("a[href]") as HTMLAnchorElement | null;
      if (!link || link.target || link.hasAttribute("download")) return;
      const url = new URL(link.href, location.href);
      if (url.origin !== location.origin) return;
      if (url.pathname === location.pathname && url.search === location.search) {
        if (url.hash) return; // in-page anchors: menu.js / the browser handle these
        // Link to the page we're already on (e.g. START A PROJECT on /contact): a plain browser reload
        // flashes white — stay put instead: close the menu if open and glide back to the top.
        event.preventDefault();
        if (root.classList.contains("is-menu-open")) (document.querySelector("[data-menu-toggle]") as HTMLElement | null)?.click();
        const l = lenis();
        if (l) l.scrollTo(0, { duration: 1.2 });
        else scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
        return;
      }
      event.preventDefault();
      leave(url.href);
    });

    // Going into the back/forward cache (e.g. the visitor pressed Back): freeze the page under a
    // full ink cover, so it is restored covered and opens with the reveal instead of flashing.
    addEventListener("pagehide", (event) => {
      if (!event.persisted) return;
      cancelAnimationFrame(raf);
      resize();
      draw(0, performance.now(), 0, false);
      show();
      preloader.classList.remove("is-running"); // solid ink background too, in case the canvas is discarded
    });

    // Back/forward cache: the page comes back still covered — open it again.
    addEventListener("pageshow", (event) => {
      if (!event.persisted) return;
      try {
        sessionStorage.removeItem("uniflow:transition");
      } catch {}
      reveal(false);
    });

    if (mode === "load") reveal(true);
    else if (mode === "enter") reveal(false);
  }
</script>
