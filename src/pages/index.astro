---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/global/Navbar.astro";
import Hero from "../components/sections/Hero.astro";
import LogoMarquee from "../components/sections/LogoMarquee.astro";
import About from "../components/sections/About.astro";
import Stats from "../components/sections/Stats.astro";
import Works from "../components/sections/Works.astro";
import Showcase from "../components/sections/Showcase.astro"; // "Craft in Motion" ribbon — remove this + <Showcase /> to undo
import Services from "../components/sections/Services.astro";
import Tools from "../components/sections/Tools.astro"; // "Our stack" tools grid — remove this + <Tools /> to undo
import Team from "../components/sections/Team.astro";
import Process from "../components/sections/Process.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import Blog from "../components/sections/Blog.astro"; // Journal section — remove this + <Blog /> to undo
import Faq from "../components/sections/Faq.astro";
import Cta from "../components/sections/Cta.astro";
import Footer from "../components/sections/Footer.astro";
---

<Layout preloader>
  <Navbar />
  <main>
    <Hero />
    <LogoMarquee />
    <About />
    <Stats />
    <Works />
    <Showcase />
    <Services />
    <Tools />
    <Team />
    <Process />
    <Testimonials />
    <Blog />
    <Faq />
    <Cta href="/contact" />
  </main>
  <Footer />
</Layout>
